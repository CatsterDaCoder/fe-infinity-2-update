diff --git a/server/ai/utilities/get-model.ts b/server/ai/utilities/get-model.ts
new file mode 100644
index 00000000..0e66e225
--- /dev/null
+++ b/server/ai/utilities/get-model.ts
@@ -0,0 +1,248 @@
+import { createOpenAI } from "@ai-sdk/openai";
+import "jsr:@std/dotenv/load";
+
+/**
+ * Chooses which LLM backend the generation pipeline talks to.
+ *
+ * Configured entirely through server/.env (or the Web UI's Setup tab):
+ *
+ *   AI_PROVIDER      "openai" (default) or "ollama"
+ *   OPENAI_API_KEY   required for the openai provider
+ *   OPENAI_MODEL     default model for the openai provider
+ *   OLLAMA_BASE_URL  default http://localhost:11434/v1
+ *   OLLAMA_MODEL     default model for the ollama provider (e.g. qwen3:14b)
+ *
+ * Ollama exposes an OpenAI-compatible endpoint, so the same @ai-sdk/openai
+ * provider works against it -- it just needs a different baseURL and
+ * `compatibility: "compatible"`, which stops the SDK from sending
+ * OpenAI-only request fields that Ollama rejects.
+ *
+ * WHAT STILL REQUIRES OPENAI: two scripts send images to the model --
+ * map-processing/ai/define-map-areas.ts and
+ * ai/portraits/portrait-metadata-creation/generate-portrait-metadata.ts.
+ * Both are one-off PREPROCESSING steps whose results are committed to the
+ * repo (all-map-options.ts, all-portrait-options.ts), so a normal game
+ * generation run never calls them. Only re-run those with a vision-capable
+ * OpenAI model; everything in the actual generation pipeline is text-only
+ * and works against Ollama.
+ */
+
+export type AiProvider = "openai" | "ollama";
+
+export const AI_PROVIDER: AiProvider =
+  (Deno.env.get("AI_PROVIDER")?.trim().toLowerCase() as AiProvider) || "openai";
+
+/**
+ * Where to reach the Ollama server.
+ *
+ * The common setup is Ollama installed on WINDOWS while this code runs in
+ * WSL. That's the right way round -- Windows-native Ollama gets GPU
+ * acceleration for free and already has your models pulled -- but WSL2
+ * runs in its own network namespace, so "localhost" from WSL is the WSL
+ * VM, not Windows. Unless WSL is in mirrored-networking mode (Windows 11
+ * 23H2+, where localhost does reach the host), you have to talk to the
+ * Windows host's IP instead.
+ *
+ * When OLLAMA_BASE_URL isn't set explicitly and we're running under WSL,
+ * guess the Windows host from the default route, which is what WSL points
+ * at the host with. An explicit OLLAMA_BASE_URL always wins.
+ */
+function detectWindowsHostFromWsl(): string | null {
+  try {
+    if (!Deno.readTextFileSync("/proc/version").toLowerCase().includes("microsoft")) {
+      return null;
+    }
+  } catch {
+    return null;
+  }
+
+  // /etc/resolv.conf's nameserver is the Windows host in standard WSL2
+  // NAT mode. In mirrored mode it's a real DNS server instead, so this is
+  // only ever a guess -- hence the connectivity probe below.
+  try {
+    const resolv = Deno.readTextFileSync("/etc/resolv.conf");
+    const match = resolv.match(/^nameserver\s+(\d+\.\d+\.\d+\.\d+)/m);
+    if (match) return match[1];
+  } catch {
+    // ignore
+  }
+  return null;
+}
+
+const OLLAMA_BASE_URL = (() => {
+  const explicit = Deno.env.get("OLLAMA_BASE_URL")?.trim();
+  if (explicit) return explicit;
+
+  const windowsHost = detectWindowsHostFromWsl();
+  if (windowsHost) {
+    return `http://${windowsHost}:11434/v1`;
+  }
+  return "http://localhost:11434/v1";
+})();
+
+/** Model used when a call site doesn't request a specific one. */
+export const DEFAULT_MODEL =
+  AI_PROVIDER === "ollama"
+    ? Deno.env.get("OLLAMA_MODEL")?.trim() || "qwen3:14b"
+    : Deno.env.get("OPENAI_MODEL")?.trim() || "gpt-4o-mini";
+
+const openaiProvider = createOpenAI({
+  apiKey: Deno.env.get("OPENAI_API_KEY") ?? "",
+});
+
+const ollamaProvider = createOpenAI({
+  baseURL: OLLAMA_BASE_URL,
+  // Ollama ignores the key but the SDK requires a non-empty string.
+  apiKey: Deno.env.get("OLLAMA_API_KEY")?.trim() || "ollama",
+  // Without this the SDK sends OpenAI-specific fields that Ollama's
+  // compatibility layer doesn't accept.
+  compatibility: "compatible",
+});
+
+/**
+ * `generateObject` picks a strategy for constraining output. OpenAI
+ * supports native structured outputs ("auto" resolves to that); Ollama's
+ * compatibility layer is much happier being asked for plain JSON with the
+ * schema described in the request, so pin it to "json" there.
+ */
+export const OBJECT_GENERATION_MODE: "auto" | "json" =
+  AI_PROVIDER === "ollama" ? "json" : "auto";
+
+/** OpenAI model families. A few call sites request a specific stronger
+ * OpenAI model (e.g. "gpt-4o" for unit placement); those ids are
+ * meaningless to Ollama, which would just report the model as not
+ * pulled. Recognize and ignore them when running locally. */
+const OPENAI_MODEL_PATTERN = /^(gpt-|o1|o3|o4|chatgpt|text-|davinci)/i;
+
+export function getModel(modelId?: string) {
+  const requested = modelId?.trim();
+
+  if (AI_PROVIDER === "ollama") {
+    const usable =
+      requested && !OPENAI_MODEL_PATTERN.test(requested)
+        ? requested
+        : DEFAULT_MODEL;
+    // structuredOutputs: true makes the SDK send
+    //   response_format: { type: "json_schema", json_schema: {...} }
+    // which Ollama enforces with grammar-constrained decoding -- the
+    // model physically cannot emit anything but conforming JSON.
+    //
+    // Without it, the SDK doesn't recognize model ids like "qwen3:14b"
+    // as structured-output capable, so it silently degrades to
+    // `response_format: { type: "json_object" }` and describes the
+    // schema in the prompt instead. Local models handle that badly: in
+    // practice qwen3 echoed the JSON SCHEMA ITSELF back as its answer,
+    // then returned empty objects on the retries.
+    //
+    // Requires Ollama >= 0.5. If you're on something older, upgrade --
+    // schema enforcement is what makes local models usable here at all.
+    return ollamaProvider(usable, { structuredOutputs: true });
+  }
+
+  return openaiProvider(requested || DEFAULT_MODEL);
+}
+
+/**
+ * Qwen3 (and other reasoning-mode models) emit a <think>...</think>
+ * preamble before their answer by default. That preamble is not valid
+ * JSON, so it breaks structured-object parsing. Qwen3 honours a `/no_think`
+ * directive in the prompt to suppress it -- append it for models that
+ * look like they reason by default.
+ *
+ * Harmless for models that don't recognize it, but only added when it's
+ * likely to be needed, to avoid polluting prompts unnecessarily.
+ */
+export function adaptSystemMessage(systemMessage: string): string {
+  if (AI_PROVIDER !== "ollama") return systemMessage;
+
+  const modelLooksLikeReasoner = /qwen3|deepseek-r1|reason|think/i.test(
+    DEFAULT_MODEL
+  );
+  if (!modelLooksLikeReasoner) return systemMessage;
+
+  return `${systemMessage}\n\n/no_think\n\nRespond with ONLY the requested JSON object. Do not include any explanation, commentary, markdown code fences, or <think> blocks before or after it.`;
+}
+
+/**
+ * Verifies the Ollama server is actually reachable and has the requested
+ * model, failing with actionable instructions rather than letting the
+ * first generation call die with an opaque connection error.
+ *
+ * Probes the configured URL and, if that fails, the likely alternatives,
+ * so it can tell you exactly what to put in .env rather than just that
+ * something is wrong.
+ */
+export async function verifyOllamaReachable(): Promise<void> {
+  if (AI_PROVIDER !== "ollama") return;
+
+  const candidates = [OLLAMA_BASE_URL];
+  const windowsHost = detectWindowsHostFromWsl();
+  if (windowsHost) candidates.push(`http://${windowsHost}:11434/v1`);
+  candidates.push("http://localhost:11434/v1");
+  candidates.push("http://host.docker.internal:11434/v1");
+
+  const tried = new Set<string>();
+  for (const baseUrl of candidates) {
+    if (tried.has(baseUrl)) continue;
+    tried.add(baseUrl);
+
+    try {
+      const res = await fetch(`${baseUrl}/models`, {
+        signal: AbortSignal.timeout(4000),
+      });
+      if (!res.ok) continue;
+
+      const body = await res.json();
+      const available: string[] = (body?.data ?? []).map(
+        (m: { id: string }) => m.id
+      );
+
+      if (baseUrl !== OLLAMA_BASE_URL) {
+        throw new Error(
+          `Ollama isn't reachable at ${OLLAMA_BASE_URL}, but IS reachable at ${baseUrl}.\n` +
+            `Set this in server/.env (or the Web UI Setup tab):\n` +
+            `  OLLAMA_BASE_URL=${baseUrl}`
+        );
+      }
+
+      // Ollama reports models with their tag (e.g. "qwen3-fe:latest"),
+      // so compare on the part before the tag too.
+      const wanted = DEFAULT_MODEL;
+      const isPresent = available.some(
+        (m) => m === wanted || m.split(":")[0] === wanted.split(":")[0]
+      );
+      if (!isPresent) {
+        throw new Error(
+          `Ollama is running at ${baseUrl}, but the model "${wanted}" isn't available there.\n` +
+            `Models it does have: ${available.join(", ") || "(none)"}\n` +
+            `Pull or create it on the machine running Ollama, e.g.:\n` +
+            `  ollama pull qwen3:14b\n` +
+            `then build an enlarged-context variant (see README) and set OLLAMA_MODEL to its name.`
+        );
+      }
+      return;
+    } catch (err) {
+      // A thrown Error above is a real diagnosis -- surface it. Anything
+      // else is just this candidate being unreachable; keep probing.
+      if (err instanceof Error && err.message.startsWith("Ollama")) throw err;
+    }
+  }
+
+  throw new Error(
+    `Could not reach an Ollama server (tried: ${[...tried].join(", ")}).\n` +
+      `If Ollama is installed on Windows and this is running in WSL:\n` +
+      `  1. On Windows, set the environment variable OLLAMA_HOST=0.0.0.0 and restart Ollama,\n` +
+      `     so it listens on all interfaces instead of only 127.0.0.1.\n` +
+      `  2. Allow port 11434 through Windows Firewall (private networks is enough).\n` +
+      `  3. Set OLLAMA_BASE_URL in server/.env to http://<windows-ip>:11434/v1\n` +
+      `     (find it with 'ipconfig' on Windows, or check the addresses tried above).\n` +
+      `Otherwise, confirm Ollama is running: 'ollama list'.`
+  );
+}
+
+/** Human-readable description of the active backend, for startup logs. */
+export function describeProvider(): string {
+  return AI_PROVIDER === "ollama"
+    ? `Ollama (${OLLAMA_BASE_URL}) model "${DEFAULT_MODEL}"`
+    : `OpenAI model "${DEFAULT_MODEL}"`;
+}
