diff --git a/server/map-processing/get-info-from-tmx/get-main-layer-tiles.ts b/server/map-processing/get-info-from-tmx/get-main-layer-tiles.ts
new file mode 100644
index 00000000..ba026cd2
--- /dev/null
+++ b/server/map-processing/get-info-from-tmx/get-main-layer-tiles.ts
@@ -0,0 +1,95 @@
+import pako from "npm:pako";
+import findMainLayer from "@/map-processing/find-main-layer.ts";
+
+/**
+ * Extracts the main layer's tile GIDs from a .tmx file, handling every
+ * layer format Tiled can save.
+ *
+ * The original code only understood `<data encoding="base64"
+ * compression="zlib">`, and threw "main layer is not compressed" for
+ * anything else. That's just one of Tiled's five output formats, and
+ * plenty of FE map packs ship the others -- particularly plain XML, which
+ * is what you get if the map was made in an older editor or exported
+ * without compression. Those maps aren't broken; we simply couldn't read
+ * them.
+ *
+ * Supported:
+ *   - encoding="base64" compression="zlib"  (the original path)
+ *   - encoding="base64" compression="gzip"
+ *   - encoding="base64" with no compression
+ *   - encoding="csv"
+ *   - no encoding at all: <tile gid="..."/> elements
+ */
+
+function gidsFromBytes(bytes: Uint8Array): number[] {
+  const gids: number[] = [];
+  for (let i = 0; i + 3 < bytes.length; i += 4) {
+    gids.push(
+      bytes[i] | (bytes[i + 1] << 8) | (bytes[i + 2] << 16) | (bytes[i + 3] << 24)
+    );
+  }
+  return gids;
+}
+
+function base64ToBytes(b64: string): Uint8Array {
+  const binary = atob(b64.replace(/\s+/g, ""));
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+}
+
+export default function getMainLayerTiles(tmx: string): number[] {
+  // Which layer counts as "main" is decided in one place for the whole
+  // pipeline -- see find-main-layer.ts. Reading terrain from one layer
+  // while prepare-tmx.ts wrote the ROM properties to another was a real
+  // bug, so they now can't drift apart.
+  const mainLayer = findMainLayer(tmx);
+  if (!mainLayer) {
+    throw new Error("no <layer> element found in the .tmx");
+  }
+  const layerBody = mainLayer.inner;
+
+  const dataMatch = layerBody.match(/<data([^>]*)>([\s\S]*?)<\/data>/i);
+  if (!dataMatch) {
+    throw new Error("the main layer has no <data> element");
+  }
+
+  const attrs = dataMatch[1];
+  const body = dataMatch[2];
+  const encoding = attrs.match(/encoding="([^"]+)"/i)?.[1]?.toLowerCase();
+  const compression = attrs.match(/compression="([^"]+)"/i)?.[1]?.toLowerCase();
+
+  if (encoding === "base64") {
+    const bytes = base64ToBytes(body.trim());
+    if (compression === "zlib" || compression === "gzip") {
+      return gidsFromBytes(pako.inflate(bytes));
+    }
+    if (!compression) {
+      return gidsFromBytes(bytes);
+    }
+    throw new Error(`unsupported layer compression "${compression}"`);
+  }
+
+  if (encoding === "csv") {
+    return body
+      .split(",")
+      .map((n) => parseInt(n.trim(), 10))
+      .filter((n) => !Number.isNaN(n));
+  }
+
+  if (!encoding) {
+    // Plain XML: a <tile gid="N"/> per cell. Empty cells may omit gid.
+    const tiles = [...body.matchAll(/<tile\b([^>]*)\/?>/gi)];
+    if (tiles.length === 0) {
+      throw new Error(
+        "the main layer's <data> has no encoding attribute and no <tile> elements"
+      );
+    }
+    return tiles.map((m) => {
+      const gid = m[1].match(/gid="(\d+)"/i)?.[1];
+      return gid ? parseInt(gid, 10) : 0;
+    });
+  }
+
+  throw new Error(`unsupported layer encoding "${encoding}"`);
+}
