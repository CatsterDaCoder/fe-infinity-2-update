@@ -0,0 +1,24 @@
+#!/bin/bash
+# Source this (`. "$(dirname "$0")/ensure-mono.sh"`) before any `mono ...`
+# call. ColorzCore.exe is a genuine .NET assembly -- unlike the macOS-only
+# binaries elsewhere in this repo, it CAN run on Linux/WSL/macOS, but only
+# if a compatible runtime is actually installed. Without this check, a
+# missing `mono` just produces a bare "mono: command not found" from bash
+# with no indication of what that means or how to fix it.
+if ! command -v mono &>/dev/null; then
+  echo "Error: 'mono' is required to run ColorzCore.exe (the Event Assembler core) and wasn't found." >&2
+  echo "Install it, then re-run:" >&2
+  case "$(uname -s)" in
+  Linux*)
+    echo "  sudo apt install mono-complete   # Debian/Ubuntu/WSL" >&2
+    echo "  (or your distro's equivalent package if not Debian-based)" >&2
+    ;;
+  Darwin*)
+    echo "  brew install mono" >&2
+    ;;
+  *)
+    echo "  See https://www.mono-project.com/download/stable/ for your platform." >&2
+    ;;
+  esac
+  exit 1
+fi
