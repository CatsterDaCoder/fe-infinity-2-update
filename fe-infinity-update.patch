+  "5D": "5B005C5D", // FE7 - Ship
+  "61": "5F006061", // FE8 - Black Temple
+  "68": "66006768", // FE6 - Snow
+  "6C": "6A006B6C", // FE7 - Mountainous
+  "6E": "6C006D6E", // FE8 - Mountainous
+  "75": "73007475", // FE6 - Snow Castle
