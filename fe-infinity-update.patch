+// Zero-build vanilla JS frontend for the fe-infinity Web UI. Talks to the
+// Deno server (server.ts) over plain JSON + one SSE endpoint for live logs.
+
+const state = {
+  prompts: [],
+  activePromptId: null,
+  currentRunId: null,
+  eventSource: null,
+};
+
+// --------------------------------------------------------------- tab nav
+
+function initTabs() {
+  const navItems = document.querySelectorAll(".nav-item");
+  navItems.forEach((btn) => {
+    btn.addEventListener("click", () => {
+      const tab = btn.dataset.tab;
+      navItems.forEach((b) => b.classList.toggle("is-active", b === btn));
+      document.querySelectorAll(".panel").forEach((panel) => {
+        panel.hidden = panel.id !== `panel-${tab}`;
+      });
+      if (tab === "prompts" && state.prompts.length === 0) {
+        loadPrompts();
+      }
+    });
+  });
+}
+
+// -------------------------------------------------------------- setup tab
+
+async function refreshSetupStatus() {
+  const statusDot = document.getElementById("status-dot");
+  const statusText = document.getElementById("status-text");
+  const apiKeyStatus = document.getElementById("api-key-status");
+  try {
+    const res = await fetch("/api/setup");
+    const data = await res.json();
+    const modelInput = document.getElementById("model-input");
+    if (modelInput) modelInput.value = data.model || "";
+    const providerSelect = document.getElementById("provider-select");
+    if (providerSelect && data.provider) providerSelect.value = data.provider;
+    const urlInput = document.getElementById("ollama-url-input");
+    if (urlInput) urlInput.value = data.ollamaBaseUrl || "";
+    applyProviderVisibility(data.provider || "openai");
+    if (data.hasApiKey) {
+      statusDot.className = "status-dot ok";
+      statusText.textContent = "API key configured";
+      apiKeyStatus.textContent = "A key is already saved. Saving a new one will replace it.";
+      apiKeyStatus.className = "field-hint ok";
+    } else {
+      statusDot.className = "status-dot warn";
+      statusText.textContent = "No API key yet";
+      apiKeyStatus.textContent = "";
+      apiKeyStatus.className = "field-hint";
+    }
+  } catch (err) {
+    statusDot.className = "status-dot bad";
+    statusText.textContent = "Can't reach server";
+    console.error(err);
+  }
+}
+
+function applyProviderVisibility(provider) {
+  const isOllama = provider === "ollama";
+  const ollamaFields = document.getElementById("ollama-fields");
+  if (ollamaFields) ollamaFields.hidden = !isOllama;
+  const openaiFields = document.getElementById("openai-fields");
+  if (openaiFields) openaiFields.hidden = isOllama;
+  const modelInput = document.getElementById("model-input");
+  if (modelInput) {
+    modelInput.placeholder = isOllama ? "qwen3:8b" : "gpt-4o-mini";
+  }
+  const hint = document.getElementById("model-hint");
+  if (hint) {
+    hint.innerHTML = isOllama
+      ? 'The Ollama model tag to use, e.g. <code>qwen3:8b</code>. It must already be pulled (<code>ollama pull qwen3:8b</code>) and should be a version with an enlarged context window.'
+      : 'Leave blank to use <code>gpt-4o-mini</code>, the cheap default. A stronger model such as <code>gpt-4o</code> writes noticeably better stories and follows instructions more reliably, at higher cost per run.';
+  }
+}
+
+async function saveSetupField(payload, statusId, successText) {
+  const status = document.getElementById(statusId);
+  try {
+    const res = await fetch("/api/setup", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify(payload),
+    });
+    if (!res.ok) throw new Error(await res.text());
+    if (status) {
+      status.textContent = successText;
+      status.className = "field-hint ok";
+    }
+    refreshSetupStatus();
+  } catch (err) {
+    if (status) {
+      status.textContent = `Failed to save: ${err}`;
+      status.className = "field-hint bad";
+    }
+  }
+}
+
+/** Attaches a click handler only if the element exists. A missing element
+ * used to throw inside initSetup(), which aborted the whole function and
+ * silently broke every other control on the Setup tab -- including the
+ * Save key button. */
+function onClick(id, handler) {
+  const el = document.getElementById(id);
+  if (!el) {
+    console.warn(`Setup control "${id}" not found in the DOM; skipping.`);
+    return;
+  }
+  el.addEventListener("click", handler);
+}
+
+function initSetup() {
+  const providerSelect = document.getElementById("provider-select");
+  if (providerSelect) {
+    // Save immediately on change rather than requiring a separate button
+    // press. Previously you could pick "Ollama", save some other field,
+    // and have the UI snap back to OpenAI -- because the refresh after
+    // that save re-read the still-unchanged provider from the server.
+    providerSelect.addEventListener("change", async () => {
+      applyProviderVisibility(providerSelect.value);
+      await saveSetupField(
+        { provider: providerSelect.value },
+        "provider-status",
+        `Provider set to ${providerSelect.value}.`
+      );
+    });
+  }
+  onClick("save-provider", () =>
+    saveSetupField(
+      { provider: document.getElementById("provider-select").value },
+      "provider-status",
+      `Provider set to ${document.getElementById("provider-select").value}.`
+    )
+  );
+  onClick("save-ollama-url", () =>
+    saveSetupField(
+      {
+        // Send the provider too, so saving the URL can't be interpreted
+        // against a stale server-side provider value.
+        provider: document.getElementById("provider-select")?.value,
+        ollamaBaseUrl: document
+          .getElementById("ollama-url-input")
+          .value.trim(),
+      },
+      "ollama-url-status",
+      "Ollama URL saved."
+    )
+  );
+
+  onClick("save-model", async () => {
+    const status = document.getElementById("model-status");
+    const model = document.getElementById("model-input").value.trim();
+    try {
+      const res = await fetch("/api/setup", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        // The provider is sent with the model so the server knows which
+        // key to store it under (OPENAI_MODEL vs OLLAMA_MODEL). Without
+        // it the server fell back to whatever provider was last SAVED,
+        // so picking "Ollama" and typing a model name without saving the
+        // provider first silently wrote the Ollama model into
+        // OPENAI_MODEL -- which is how a run ended up reporting
+        // `Using OpenAI model "qwen3-fe"`.
+        body: JSON.stringify({
+          model,
+          provider: document.getElementById("provider-select")?.value,
+        }),
+      });
+      if (!res.ok) throw new Error(await res.text());
+      const isOllama =
+        document.getElementById("provider-select")?.value === "ollama";
+      status.textContent = model
+        ? `Saved. Runs will use ${model}.`
+        : `Cleared. Runs will use the default (${
+            isOllama ? "qwen3:14b" : "gpt-4o-mini"
+          }).`;
+      status.className = "field-hint ok";
+    } catch (err) {
+      status.textContent = `Failed to save: ${err}`;
+      status.className = "field-hint bad";
+    }
+  });
+
+  onClick("save-api-key", async () => {
+    const input = document.getElementById("api-key-input");
+    const apiKeyStatus = document.getElementById("api-key-status");
+    const apiKey = input.value.trim();
+    if (!apiKey) {
+      apiKeyStatus.textContent = "Enter a key first.";
+      apiKeyStatus.className = "field-hint bad";
+      return;
+    }
+    try {
+      const res = await fetch("/api/setup", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ apiKey }),
+      });
+      if (!res.ok) throw new Error(await res.text());
+      input.value = "";
+      apiKeyStatus.textContent = "Saved to server/.env.";
+      apiKeyStatus.className = "field-hint ok";
+      refreshSetupStatus();
+    } catch (err) {
+      apiKeyStatus.textContent = `Failed to save: ${err}`;
+      apiKeyStatus.className = "field-hint bad";
+    }
+  });
+}
+
+// ------------------------------------------------------------ prompts tab
+
+async function loadPrompts() {
+  const list = document.getElementById("prompts-list");
+  list.innerHTML = '<p class="loading-text">Loading prompts&hellip;</p>';
+  try {
+    const res = await fetch("/api/prompts");
+    state.prompts = await res.json();
+    renderPromptsList();
+  } catch (err) {
+    list.innerHTML = `<p class="loading-text">Failed to load prompts: ${escapeHtml(String(err))}</p>`;
+  }
+}
+
+function renderPromptsList() {
+  const list = document.getElementById("prompts-list");
+  const groups = new Map();
+  for (const p of state.prompts) {
+    if (!groups.has(p.group)) groups.set(p.group, []);
+    groups.get(p.group).push(p);
+  }
+
+  list.innerHTML = "";
+  for (const [group, prompts] of groups) {
+    const label = document.createElement("div");
+    label.className = "prompt-group-label";
+    label.textContent = group;
+    list.appendChild(label);
+
+    for (const p of prompts) {
+      const btn = document.createElement("button");
+      btn.className = "prompt-item" + (p.id === state.activePromptId ? " is-active" : "");
+      btn.dataset.id = p.id;
+      btn.innerHTML = `<span>${escapeHtml(p.label)}</span>${
+        p.isOverridden ? '<span class="prompt-item-badge">edited</span>' : ""
+      }`;
+      btn.addEventListener("click", () => {
+        state.activePromptId = p.id;
+        renderPromptsList();
+        renderPromptEditor(p.id);
+      });
+      list.appendChild(btn);
+    }
+  }
+}
+
+function renderPromptEditor(id) {
+  const editor = document.getElementById("prompt-editor");
+  const p = state.prompts.find((x) => x.id === id);
+  if (!p) {
+    editor.innerHTML = '<p class="empty-hint">Select a prompt on the left to view or edit it.</p>';
+    return;
+  }
+
+  editor.innerHTML = `
+    <h2>${escapeHtml(p.label)}</h2>
+    <p class="prompt-meta">${escapeHtml(p.description)}</p>
+    <p class="prompt-source">${escapeHtml(p.sourceFile)}</p>
+    <textarea id="prompt-textarea" spellcheck="false">${escapeHtml(p.current)}</textarea>
+    <div class="editor-actions">
+      <button class="btn btn-primary" id="save-prompt">Save</button>
+      <button class="btn btn-ghost" id="reset-prompt" ${p.isOverridden ? "" : "disabled"}>Reset to default</button>
+      <span class="field-hint" id="prompt-save-hint"></span>
+    </div>
+  `;
+
+  document.getElementById("save-prompt").addEventListener("click", async () => {
+    const hint = document.getElementById("prompt-save-hint");
+    const value = document.getElementById("prompt-textarea").value;
+    try {
+      const res = await fetch(`/api/prompts/${encodeURIComponent(id)}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ value }),
+      });
+      if (!res.ok) throw new Error(await res.text());
+      p.current = value;
+      p.isOverridden = value !== p.default;
+      hint.textContent = "Saved. Applies to your next run.";
+      hint.className = "field-hint ok";
+      renderPromptsList();
+    } catch (err) {
+      hint.textContent = `Failed to save: ${err}`;
+      hint.className = "field-hint bad";
+    }
+  });
+
+  document.getElementById("reset-prompt").addEventListener("click", async () => {
+    const hint = document.getElementById("prompt-save-hint");
+    try {
+      const res = await fetch(`/api/prompts/${encodeURIComponent(id)}/reset`, {
+        method: "POST",
+      });
+      if (!res.ok) throw new Error(await res.text());
+      p.current = p.default;
+      p.isOverridden = false;
+      renderPromptEditor(id);
+      renderPromptsList();
+      hint.textContent = "Reset to default.";
+      hint.className = "field-hint ok";
+    } catch (err) {
+      hint.textContent = `Failed to reset: ${err}`;
+      hint.className = "field-hint bad";
+    }
+  });
+}
+
+// ----------------------------------------------------------- generate tab
+
+function initGenerate() {
+  const form = document.getElementById("generate-form");
+  form.addEventListener("submit", async (e) => {
+    e.preventDefault();
+    const worldIdea = document.getElementById("world-idea").value.trim();
+    const numberOfChapters = Number(document.getElementById("chapters").value) || 3;
+    const skipRomBuild = document.getElementById("skip-rom-build").checked;
+    if (!worldIdea) return;
+
+    setGenerateFormBusy(true);
+    clearLog();
+    setRunStatus("running", "Starting generation…");
+
+    try {
+      const res = await fetch("/api/generate", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ worldIdea, numberOfChapters, skipRomBuild }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error || "Failed to start");
+      state.currentRunId = data.runId;
+      streamRun(data.runId);
+    } catch (err) {
+      setRunStatus("bad", `Failed to start: ${err}`);
+      setGenerateFormBusy(false);
+    }
+  });
+
+  document.getElementById("cancel-generate").addEventListener("click", async () => {
+    if (!state.currentRunId) return;
+    await fetch(`/api/generate/${state.currentRunId}/cancel`, { method: "POST" });
+  });
+}
+
+function setGenerateFormBusy(busy) {
+  document.getElementById("start-generate").disabled = busy;
+  document.getElementById("cancel-generate").hidden = !busy;
+}
+
+function setRunStatus(kind, text) {
+  const wrap = document.getElementById("run-status");
+  const dot = document.getElementById("run-status-dot");
+  const label = document.getElementById("run-status-text");
+  wrap.hidden = false;
+  dot.className = `status-dot ${kind === "running" ? "running" : kind}`;
+  label.textContent = text;
+}
+
+function clearLog() {
+  document.getElementById("log-console").textContent = "";
+}
+
+function appendLog(line) {
+  const el = document.getElementById("log-console");
+  const span = document.createElement("div");
+  if (/error|❌/i.test(line)) span.className = "log-line-error";
+  else if (/warn|🙁/i.test(line)) span.className = "log-line-warn";
+  else if (/✅/i.test(line)) span.className = "log-line-ok";
+  span.textContent = line;
+  el.appendChild(span);
+  el.scrollTop = el.scrollHeight;
+}
+
+function streamRun(runId) {
+  if (state.eventSource) state.eventSource.close();
+  const es = new EventSource(`/api/generate/${runId}/events`);
+  state.eventSource = es;
+
+  es.addEventListener("line", (e) => {
+    const { line } = JSON.parse(e.data);
+    appendLog(line);
+  });
+
+  es.addEventListener("done", (e) => {
+    const { status, exitCode } = JSON.parse(e.data);
+    if (status === "success") {
+      setRunStatus("ok", "Done — generation finished successfully.");
+    } else if (status === "cancelled") {
+      setRunStatus("warn", "Cancelled.");
+    } else {
+      setRunStatus("bad", `Failed (exit code ${exitCode ?? "?"}). See log above.`);
+    }
+    setGenerateFormBusy(false);
+    es.close();
+    state.eventSource = null;
+  });
+
+  es.onerror = () => {
+    // The server closes the stream itself on completion; an error here
+    // after that point is expected and not worth alarming the user about.
+  };
+}
+
+// ------------------------------------------------------------------ utils
+
+function escapeHtml(str) {
+  const div = document.createElement("div");
+  div.textContent = str;
+  return div.innerHTML;
+}
+
+// ------------------------------------------------------------------- init
+
+initTabs();
+initSetup();
+initGenerate();
+refreshSetupStatus();
