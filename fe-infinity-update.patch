+  "7C": "7A007B7C", // FE6 - Mountainous
+  "7D": "7B007C7D", // FE7 - Desert
+  "83": "81008283", // FE6 - Stronghold
+  "8A": "8800898A", // FE8 - Temple
+  "90": "8E008F90", // FE6 - Temple
+  "93": "91009293", // FE7 - Snow Castle
+  "A7": "A500A6A7", // FE6 - Plains
+  "A9": "A700A8A9", // FE7 - Lava Cave
+  "AC": "A500ABAC", // FE6 - Plains Village
+  "B0": "AE00AFB0", // FE7 - Cave
+  "B3": "B100B2B3", // FE6 - Plains Castle
+  "BE": "5300BDBE", // FE6 - Cave
+  "C3": "C100C2C3", // FE7 - Dragon Gate
+};
+
+/**
+ * Looks up a tileset's terrain tags. Accepts a full 8-hex id (preferred,
+ * unambiguous), a bare config byte (legacy), or the name of a ported
+ * tileset. Returns null if unknown.
+ *
+ * Ported tilesets are checked FIRST and never fall through to the hex
+ * paths, because their names are not hex: "OutdoorSnowy".slice(-2) is
+ * "wy", which would just miss, and a name that happened to end in two
+ * hex-looking characters would silently match an unrelated tileset.
+ */
+export function getTerrainTags(tilesetIdOrConfigByte: string): string | null {
+  const ported = findPortedTileset(tilesetIdOrConfigByte);
+  if (ported) return portedTilesetTerrain[ported.terrainConfigKey] ?? null;
+
+  const key = tilesetIdOrConfigByte.toUpperCase();
+  if (terrainTagsByTilesetId[key]) return terrainTagsByTilesetId[key];
+  const viaByte = tilesetIdByConfigByte[key.slice(-2)];
+  return viaByte ? terrainTagsByTilesetId[viaByte] ?? null : null;
+}
+
+/** Every tileset id this build knows terrain data for. */
+export const KNOWN_TILESET_IDS = Object.keys(terrainTagsByTilesetId);
+
+export default terrainTagsByTilesetId;
