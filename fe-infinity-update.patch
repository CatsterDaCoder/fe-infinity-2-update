@@ -0,0 +1,171 @@
+import { MapArea } from "@/types/ai/MapAreas.ts";
+import { MapLocation } from "@/types/map-location.ts";
+
+/**
+ * Produces map areas (named, described, bounded regions) directly from the
+ * terrain grid, with no AI call.
+ *
+ * The original pipeline got these from `define-map-areas.ts`, which sends
+ * the map's PNG to a vision model. That has two problems for anyone
+ * adding their own maps:
+ *
+ *   1. It requires an OpenAI key and a vision-capable model, so it can't
+ *      run against a local Ollama setup at all.
+ *   2. A vision model eyeballing a 20x18 grid of 16px tiles guesses at
+ *      coordinates. Everything downstream -- unit placement, boss
+ *      positioning -- then trusts those bounds as exact. Coordinates read
+ *      off the actual tile data are correct by construction.
+ *
+ * The tradeoff is flavour: a vision model might call something "the
+ * ruined chapel", whereas this produces "Northwest Woodland". The area
+ * names are only used to help the AI reason about space and to be
+ * referenced in battle overviews, so accuracy matters more than poetry.
+ */
+
+/** Terrain types that suggest what a region should be called, in priority
+ * order -- the first match with meaningful presence wins the name. */
+const TERRAIN_CHARACTER: { pattern: RegExp; noun: string; weight: number }[] = [
+  { pattern: /^Throne$/i, noun: "Throne Room", weight: 100 },
+  { pattern: /^(Castle Gate|Fort Gate|Gate)$/i, noun: "Gatehouse", weight: 90 },
+  { pattern: /^Chest$/i, noun: "Treasury", weight: 80 },
+  { pattern: /^(Village|House|Shop|Armory|Vendor)$/i, noun: "Settlement", weight: 70 },
+  { pattern: /^Fort$/i, noun: "Fort", weight: 60 },
+  { pattern: /^(Ruins|Pillar|Brace)$/i, noun: "Ruins", weight: 50 },
+  { pattern: /^Stairs$/i, noun: "Stairway", weight: 40 },
+  { pattern: /^Door$/i, noun: "Doorway", weight: 40 },
+  { pattern: /^(Floor|Wall)$/i, noun: "Interior", weight: 20 },
+  { pattern: /^(Forest|Thicket)$/i, noun: "Woodland", weight: 18 },
+  { pattern: /^(Peak|Cliff|Mountain|Hill)$/i, noun: "Highlands", weight: 16 },
+  { pattern: /^(Sea|Lake|Water|River|Bridge)$/i, noun: "Waterside", weight: 14 },
+  { pattern: /^(Sand|Desert|Dune)$/i, noun: "Sands", weight: 12 },
+  { pattern: /^Road$/i, noun: "Crossroads", weight: 10 },
+  { pattern: /^(Plains|Grass)$/i, noun: "Plains", weight: 5 },
+];
+
+const COMPASS_3 = [
+  ["Northwest", "North", "Northeast"],
+  ["West", "Central", "East"],
+  ["Southwest", "South", "Southeast"],
+];
+
+function describeRegion(tiles: MapLocation[]): {
+  noun: string;
+  counts: Map<string, number>;
+} {
+  const counts = new Map<string, number>();
+  for (const t of tiles) {
+    counts.set(t.terrain, (counts.get(t.terrain) ?? 0) + 1);
+  }
+
+  let best = { noun: "Field", score: -1 };
+  for (const [terrain, count] of counts) {
+    const entry = TERRAIN_CHARACTER.find((c) => c.pattern.test(terrain));
+    if (!entry) continue;
+    // Weight by how distinctive the terrain is AND how much of it there
+    // is, so a single Throne tile still names the region but a lone tree
+    // doesn't override an otherwise open plain.
+    const score = entry.weight * Math.sqrt(count);
+    if (score > best.score) best = { noun: entry.noun, score };
+  }
+  return { noun: best.noun, counts };
+}
+
+function summarize(counts: Map<string, number>, total: number): string {
+  const top = [...counts.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, 3)
+    .map(([terrain, n]) => `${terrain} (${Math.round((n / total) * 100)}%)`);
+  return top.join(", ");
+}
+
+export default function deriveMapAreas({
+  width,
+  height,
+  terrainGrid,
+  pointsOfInterest,
+}: {
+  width: number;
+  height: number;
+  terrainGrid: MapLocation[];
+  pointsOfInterest: MapLocation[];
+}): { description: string; areas: MapArea[] } {
+  // A 3x3 split gives areas big enough to hold a squad but small enough
+  // to be meaningfully distinct. Very narrow maps collapse to fewer
+  // columns/rows so we don't emit 2-tile-wide "regions".
+  const cols = width >= 12 ? 3 : width >= 6 ? 2 : 1;
+  const rows = height >= 12 ? 3 : height >= 6 ? 2 : 1;
+
+  const areas: MapArea[] = [];
+  const usedNames = new Set<string>();
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      const fromX = Math.floor((c * width) / cols);
+      const toX = Math.floor(((c + 1) * width) / cols) - 1;
+      const fromY = Math.floor((r * height) / rows);
+      const toY = Math.floor(((r + 1) * height) / rows) - 1;
+
+      const tiles = terrainGrid.filter(
+        (t) => t.x >= fromX && t.x <= toX && t.y >= fromY && t.y <= toY
+      );
+      if (tiles.length === 0) continue;
+
+      const { noun, counts } = describeRegion(tiles);
+
+      // Compass label scaled to however many rows/cols this map got.
+      const compassRow = COMPASS_3[rows === 1 ? 1 : Math.round((r * 2) / (rows - 1))];
+      const compass =
+        cols === 1
+          ? compassRow[1]
+          : compassRow[Math.round((c * 2) / (cols - 1))];
+
+      let name = compass === "Central" ? `Central ${noun}` : `${compass} ${noun}`;
+      // Names are used as identifiers by the placement AI, so they must
+      // be unique within a map.
+      let suffix = 2;
+      while (usedNames.has(name)) {
+        name = `${compass} ${noun} ${suffix++}`;
+      }
+      usedNames.add(name);
+
+      const poisHere = pointsOfInterest.filter(
+        (p) => p.x >= fromX && p.x <= toX && p.y >= fromY && p.y <= toY
+      );
+      const poiText =
+        poisHere.length > 0
+          ? ` Contains ${poisHere
+              .map((p) => `${p.terrain} at (${p.x}, ${p.y})`)
+              .join(", ")}.`
+          : "";
+
+      areas.push({
+        name,
+        description: `The ${compass.toLowerCase()} region of the map, spanning x ${fromX}-${toX}, y ${fromY}-${toY}. Terrain is mostly ${summarize(
+          counts,
+          tiles.length
+        )}.${poiText}`,
+        coordinateArea: {
+          from: { x: fromX, y: fromY },
+          to: { x: toX, y: toY },
+        },
+      });
+    }
+  }
+
+  const allCounts = new Map<string, number>();
+  for (const t of terrainGrid) {
+    allCounts.set(t.terrain, (allCounts.get(t.terrain) ?? 0) + 1);
+  }
+  const notable = pointsOfInterest.length
+    ? ` Notable tiles: ${[
+        ...new Set(pointsOfInterest.map((p) => p.terrain)),
+      ].join(", ")}.`
+    : "";
+
+  const description = `A ${width}x${height} battlefield, predominantly ${summarize(
+    allCounts,
+    terrainGrid.length
+  )}.${notable}`;
+
+  return { description, areas };
+}
