diff --git a/server/lib/clean-text/to-rom-safe-ascii.ts b/server/lib/clean-text/to-rom-safe-ascii.ts
new file mode 100644
index 00000000..229711df
--- /dev/null
+++ b/server/lib/clean-text/to-rom-safe-ascii.ts
@@ -0,0 +1,64 @@
+/**
+ * The FE8 text parser only accepts printable ASCII -- anything else
+ * fails the whole text-assembly step with an error like
+ * "ASCII character out of range: 25". LLM output routinely contains
+ * typographic characters that look identical to ASCII in a terminal
+ * (curly quotes, en/em dashes, ellipses, non-breaking spaces), so text
+ * headed for the ROM has to be normalized first.
+ *
+ * Known lookalikes are mapped to their ASCII equivalents; anything else
+ * non-ASCII is dropped rather than left in place, since a dropped
+ * character costs a cosmetic blemish while a surviving one costs the
+ * entire build.
+ */
+const REPLACEMENTS: Record<string, string> = {
+  "\u2018": "'", // ' left single quote
+  "\u2019": "'", // ' right single quote / apostrophe
+  "\u201A": "'",
+  "\u201B": "'",
+  "\u201C": '"', // " left double quote
+  "\u201D": '"', // " right double quote
+  "\u201E": '"',
+  "\u2032": "'", // prime
+  "\u2033": '"', // double prime
+  "\u2013": "-", // en dash
+  "\u2014": "-", // em dash
+  "\u2015": "-",
+  "\u2212": "-", // minus sign
+  "\u2026": "...", // ellipsis
+  "\u00A0": " ", // non-breaking space
+  "\u2007": " ",
+  "\u202F": " ",
+  "\u2009": " ",
+  "\u200B": "", // zero-width space
+  "\u200C": "",
+  "\u200D": "",
+  "\uFEFF": "", // byte order mark
+  "\u00AB": '"',
+  "\u00BB": '"',
+  "\u2022": "-", // bullet
+};
+
+export default function toRomSafeAscii(text: string): string {
+  // NFD splits accented letters into a base letter plus a combining
+  // mark (é -> e + U+0301), so dropping the non-ASCII combining marks
+  // below leaves the readable base letter rather than deleting the
+  // whole character. This covers every accented Latin letter at once
+  // instead of needing an entry per character.
+  const decomposed = text.normalize("NFD");
+
+  let result = "";
+  for (const char of decomposed) {
+    if (char in REPLACEMENTS) {
+      result += REPLACEMENTS[char];
+      continue;
+    }
+    const code = char.codePointAt(0)!;
+    // Keep printable ASCII plus newline/tab, which the text format uses.
+    if ((code >= 0x20 && code <= 0x7e) || char === "\n" || char === "\t") {
+      result += char;
+    }
+    // Anything else is dropped.
+  }
+  return result;
+}
