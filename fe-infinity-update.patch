+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>fe-infinity — Fangame Forge</title>
+  <link rel="preconnect" href="https://fonts.googleapis.com" />
+  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
+  <link rel="stylesheet" href="/styles.css" />
+</head>
+<body>
+  <div class="app">
+    <header class="topbar">
+      <div class="brand">
+        <span class="brand-mark" aria-hidden="true">▲</span>
+        <span class="brand-text">FANGAME FORGE</span>
+      </div>
+      <div class="topbar-sub">a build console for fe&#8209;infinity</div>
+    </header>
+
+    <div class="shell">
+      <nav class="sidenav" aria-label="Sections">
+        <button class="nav-item is-active" data-tab="setup">
+          <span class="nav-cursor" aria-hidden="true">▶</span>
+          <span class="nav-label">Setup</span>
+        </button>
+        <button class="nav-item" data-tab="prompts">
+          <span class="nav-cursor" aria-hidden="true">▶</span>
+          <span class="nav-label">Prompts</span>
+        </button>
+        <button class="nav-item" data-tab="generate">
+          <span class="nav-cursor" aria-hidden="true">▶</span>
+          <span class="nav-label">Generate</span>
+        </button>
+        <div class="nav-status" id="nav-status">
+          <span class="status-dot" id="status-dot"></span>
+          <span id="status-text">checking setup&hellip;</span>
+        </div>
+      </nav>
+
+      <main class="panel-area">
+        <!-- SETUP -->
+        <section class="panel" id="panel-setup">
+          <h1 class="panel-title">Setup</h1>
+          <p class="panel-lede">Three things to check before your first build.</p>
+
+          <ol class="steps">
+            <li class="step">
+              <div class="step-num">1</div>
+              <div class="step-body">
+                <h2>AI provider &amp; model</h2>
+                <p>Choose where generation runs. Settings are stored locally in <code>server/.env</code>.</p>
+
+                <label class="field-label" for="provider-select">Provider</label>
+                <div class="field-row" style="margin-bottom:16px">
+                  <select id="provider-select" style="flex:1;background:var(--bg-inset);border:1px solid var(--border);color:var(--text);font-family:var(--mono);font-size:13.5px;padding:9px 11px;border-radius:6px;outline:none">
+                    <option value="openai">OpenAI (cloud)</option>
+                    <option value="ollama">Ollama (local)</option>
+                  </select>
+                  <button class="btn" id="save-provider">Save</button>
+                </div>
+                <p class="field-hint" id="provider-status"></p>
+
+                <div id="openai-fields">
+                  <label class="field-label" for="api-key-input">OpenAI API key</label>
+                  <div class="field-row">
+                    <input type="password" id="api-key-input" placeholder="sk-..." autocomplete="off" spellcheck="false" />
+                    <button class="btn btn-primary" id="save-api-key">Save key</button>
+                  </div>
+                  <p class="field-hint" id="api-key-status"></p>
+                </div>
+
+                <div id="ollama-fields" hidden>
+                  <label class="field-label" for="ollama-url-input">Ollama URL</label>
+                  <div class="field-row" style="margin-bottom:14px">
+                    <input type="text" id="ollama-url-input" placeholder="http://localhost:11434/v1" value="" autocomplete="off" spellcheck="false" />
+                    <button class="btn" id="save-ollama-url">Save</button>
+                  </div>
+                  <p class="field-hint" id="ollama-url-status"></p>
+                  <p style="margin:0 0 14px;color:var(--warn);font-size:12.5px;line-height:1.5"><strong>Important:</strong> this pipeline sends large prompts (map terrain data alone can exceed 4,000 tokens). Ollama defaults to a 4,096-token context and silently truncates anything longer, which produces garbage rather than an error. Build a model with a bigger context first:<br /><code>printf 'FROM qwen3:14b\nPARAMETER num_ctx 32768\n' &gt; Modelfile</code><br /><code>ollama create qwen3-fe -f Modelfile</code><br />then enter <code>qwen3-fe</code> as the model below.</p>
+                </div>
+
+                <label class="field-label" for="model-input" style="margin-top:18px">Model (optional)</label>
+                <p style="margin:0 0 8px;color:var(--text-dim);font-size:13px;line-height:1.5" id="model-hint">Leave blank to use <code>gpt-4o-mini</code>, the cheap default. A stronger model such as <code>gpt-4o</code> writes noticeably better stories and follows instructions (chapter counts, unit placement) more reliably, at higher cost per run.</p>
+                <div class="field-row">
+                  <input type="text" id="model-input" placeholder="gpt-4o-mini" autocomplete="off" spellcheck="false" />
+                  <button class="btn" id="save-model">Save model</button>
+                </div>
+                <p class="field-hint" id="model-status"></p>
+              </div>
+            </li>
+
+            <li class="step">
+              <div class="step-num">2</div>
+              <div class="step-body">
+                <h2>ROM build tools</h2>
+                <p>Building an actual <code>.gba</code> file needs a legally-obtained clean Fire Emblem 8 ROM (named <code>Clean.gba</code>, placed in <code>romBuilder/</code>), plus Wine if you're not on Windows, to run EventAssembler.</p>
+                <p class="field-hint">This part runs outside this web UI — see the project README. If you just want to test story/character generation without a ROM yet, check "skip ROM build" on the Generate tab.</p>
+              </div>
+            </li>
+
+            <li class="step">
+              <div class="step-num">3</div>
+              <div class="step-body">
+                <h2>Deno</h2>
+                <p>This whole tool — the original CLI and this web UI — runs on Deno. If <code>deno task webui</code> got you here, you already have it.</p>
+              </div>
+            </li>
+          </ol>
+        </section>
+
+        <!-- PROMPTS -->
+        <section class="panel" id="panel-prompts" hidden>
+          <h1 class="panel-title">Prompts</h1>
+          <p class="panel-lede">Every instruction sent to the model during generation, editable and grouped by pipeline stage. Edits apply to your next run immediately — no restart needed.</p>
+
+          <div class="prompts-layout">
+            <div class="prompts-list" id="prompts-list">
+              <p class="loading-text">Loading prompts&hellip;</p>
+            </div>
+            <div class="prompt-editor" id="prompt-editor">
+              <p class="empty-hint">Select a prompt on the left to view or edit it.</p>
+            </div>
+          </div>
+        </section>
+
+        <!-- GENERATE -->
+        <section class="panel" id="panel-generate" hidden>
+          <h1 class="panel-title">Generate</h1>
+          <p class="panel-lede">Describe the world you want, and watch the pipeline run in real time.</p>
+
+          <form id="generate-form" class="generate-form">
+            <label class="field-label" for="world-idea">World idea</label>
+            <textarea id="world-idea" rows="3" placeholder="e.g. a war between sky-pirate clans fighting over the last floating continent"></textarea>
+
+            <div class="field-row field-row-inline">
+              <div>
+                <label class="field-label" for="chapters">Chapters</label>
+                <input type="number" id="chapters" min="1" max="10" value="3" />
+              </div>
+              <label class="checkbox-row">
+                <input type="checkbox" id="skip-rom-build" />
+                Skip ROM build (generate story/character data only)
+              </label>
+            </div>
+
+            <div class="field-row">
+              <button type="submit" class="btn btn-primary" id="start-generate">Start generation</button>
+              <button type="button" class="btn btn-ghost" id="cancel-generate" hidden>Cancel</button>
+            </div>
+          </form>
+
+          <div class="run-status" id="run-status" hidden>
+            <span class="status-dot" id="run-status-dot"></span>
+            <span id="run-status-text"></span>
+          </div>
+
+          <pre class="log-console" id="log-console" aria-live="polite"></pre>
+        </section>
+      </main>
+    </div>
+  </div>
+
+  <script src="/app.js"></script>
+</body>
+</html>
