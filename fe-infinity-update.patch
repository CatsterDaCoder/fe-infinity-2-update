diff --git a/romBuilder/delete-sav.sh b/romBuilder/delete-sav.sh
index db0dce99..29f27b2c 100755
--- a/romBuilder/delete-sav.sh
+++ b/romBuilder/delete-sav.sh
@@ -10,5 +10,10 @@ if [[ -f "$TARGET_FILE" ]]; then
   rm "$TARGET_FILE"
   echo "Deleted: $TARGET_FILE"
 else
-  echo "Attempt to delete failed. File not found: $TARGET_FILE"
+  # Nothing to do here -- there's no save file on a first build, or after
+  # any build where nobody's actually run the ROM in an emulator yet.
+  # This used to print "Attempt to delete failed", which reads like an
