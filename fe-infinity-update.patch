+++ b/server/ai/utilities/strip-stray-terminator-code.ts
@@ -0,0 +1,20 @@
+/**
+ * `[X]` is FE8's "end of text block" control code. Our own code always
+ * appends exactly one `[X]` at the true end of a generated text block
+ * (see the various `assemble-*`/`format-*` functions that build these
+ * strings). If the model's own generated dialogue happens to already
+ * include an `[X]` partway through -- which FE8 script conventions in its
+ * training data make it prone to imitating -- the text-processing build
+ * step ends the block right there instead of at the real end. Everything
+ * the model wrote after that point becomes an orphaned fragment that
+ * doesn't start with a valid entry header, and a *later, unrelated*
+ * build step then fails with a confusing "Expected entry header, got
+ * '...'" parse error, far removed from the actual cause.
+ *
+ * Call this on any freeform AI-generated dialogue/text right before
+ * appending our own terminator, so a stray `[X]` from the model can't
+ * collide with it.
+ */
+export default function stripStrayTerminatorCode(text: string): string {
+  return text.replaceAll("[X]", "");
+}
