diff --git a/server/ai/utilities/control-codes.ts b/server/ai/utilities/control-codes.ts
new file mode 100644
index 00000000..04c26a63
--- /dev/null
+++ b/server/ai/utilities/control-codes.ts
@@ -0,0 +1,151 @@
+/**
+ * Every `[SomeCode]` token in generated dialogue eventually gets resolved
+ * by ParseFile against a fixed vocabulary (see ParseFile's `matchDefault`
+ * in https://github.com/StanHash/EventAssembler's EAFormattingSuite
+ * source) plus this project's own position/character aliases. If the
+ * model writes a code that isn't in that vocabulary -- a near-miss like
+ * `[Win]` for `[Wink]`, or a bare character name like `[Gorik]` where it
+ * meant `[LoadGorik]` -- ParseFile fails deep in the final ROM-build step
+ * with an error like "Unrecognized control code: Win", days removed from
+ * the actual generation call that produced it and unhelpful about which
+ * chapter/character caused it.
+ *
+ * This lets us catch that at generation time instead: validate the
+ * model's output against the real vocabulary, and if it invented
+ * something invalid, fail schema validation so the retry loop in
+ * `generate-structured-data.ts` gives the model a corrective nudge naming
+ * the exact bad token(s), rather than silently shipping bad text that
+ * only fails once someone actually tries to build a ROM with it.
+ */
+
+// Exact static vocabulary ParseFile recognizes by default (from
+// FEParser.hs's `matchDefault`), plus a handful of aliases this project's
+// own prompts already teach the model to use (position markers without
+// the "Open" prefix, TMM, etc.) that are resolved before reaching
+// ParseFile's fallback.
+const STATIC_CONTROL_CODES = new Set([
+  "NL",
+  "2NL",
+  "A",
+  "....",
+  ".....",
+  "......",
+  ".......",
+  "OpenFarLeft",
+  "OpenMidLeft",
+  "OpenLeft",
+  "OpenRight",
+  "OpenMidRight",
+  "OpenFarRight",
+  "OpenFarFarLeft",
+  "OpenFarFarRight",
+  "LoadFace",
+  "LoadPortrait",
+  "ClearFace",
+  "ClearPortrait",
+  "NormalPrintFE6",
+  "FastPrintFE6",
+  "CloseSpeechFast",
+  "CloseSpeechSlow",
+  "ToggleMouthMove",
+  "ToggleSmile",
+  "Yes",
+  "No",
+  "Buy/Sell",
+  "ShopContinue",
+  "SendToBack",
+  "FastPrint",
+  ".",
+  "LoadOverworldFaces",
+  "Events",
+  "G",
+  "MoveFarLeft",
+  "MoveMidLeft",
+  "MoveLeft",
+  "MoveRight",
+  "MoveMidRight",
+  "MoveFarRight",
+  "MoveFarFarLeft",
+  "MoveFarFarRight",
+  "EnableBlinking",
+  "DelayBlinking",
+  "PauseBlinking",
+  "DisableBlinking",
+  "OpenEyes",
+  "CloseEyes",
+  "HalfCloseEyes",
+  "Wink",
+  "Tact",
+  "ToggleRed",
+  "Item",
+  "SetName",
+  "ToggleColorInvert",
+  "#",
+  // Position markers this project's own prompts teach (e.g. the
+  // recruitEvent / generateScene prompts in webui/prompts/registry.ts)
+  "FarFarLeft",
+  "FarLeft",
+  "MidLeft",
+  "Left",
+  "Right",
+  "MidRight",
+  "FarRight",
+  "FarFarRight",
+  // Other aliases this project's existing prompts/example dialogue use
+  "TMM",
+  "Smile",
+  "CloseSpeech",
+  "ConversationText",
+  "BattleText",
+  "X",
+]);
+
+const HEX_BYTE = /^0x[0-9A-Fa-f]{1,2}$/;
+
+/**
+ * Returns every `[...]` token in `text` that isn't a recognized control
+ * code, given the list of character names valid for `[Load<Name>]` in
+ * this context. Empty array means everything checks out.
+ */
+export function findInvalidControlCodes(
+  text: string,
+  validCharacterNames: string[] = []
+): string[] {
+  const tokens = [...text.matchAll(/\[([^\]]*)\]/g)].map((m) => m[1]);
+  const invalid: string[] = [];
+
+  for (const token of tokens) {
+    if (STATIC_CONTROL_CODES.has(token)) continue;
+    if (HEX_BYTE.test(token)) continue;
+
+    const loadMatch = token.match(/^Load(.+)$/);
+    if (loadMatch && validCharacterNames.includes(loadMatch[1])) continue;
+
+    invalid.push(token);
+  }
+
+  return [...new Set(invalid)];
+}
+
+/**
+ * Convenience for a zod `.refine()`/`.superRefine()`: throws a
+ * descriptive message (rather than returning a boolean) so it can be
+ * dropped straight into `.refine(text => ..., errorMessage)`-style
+ * validators via the returned message, or used directly in a
+ * `superRefine` callback.
+ */
+export function describeInvalidControlCodes(
+  text: string,
+  validCharacterNames: string[] = []
+): string | null {
+  const invalid = findInvalidControlCodes(text, validCharacterNames);
+  if (invalid.length === 0) return null;
+
+  const codeList = invalid.map((c) => `[${c}]`).join(", ");
+  const validNamesNote =
+    validCharacterNames.length > 0
+      ? ` Valid names for [Load<Name>] here are: ${validCharacterNames.join(", ")}.`
+      : "";
+
+  return `Contains unrecognized control code(s): ${codeList}. Only use documented control codes (e.g. [A], [NL], position markers like [FarRight], [Load<Name>] for a character actually in this scene) -- never invent a new bracketed code or put a bare word/name in brackets on its own.${validNamesNote}`;
+}
diff --git a/server/ai/utilities/ensure-unique-character-names.ts b/server/ai/utilities/ensure-unique-character-names.ts
new file mode 100644
index 00000000..4ef3fd64
--- /dev/null
+++ b/server/ai/utilities/ensure-unique-character-names.ts
@@ -0,0 +1,69 @@
+import { StoryArc } from "@/types/ai/StoryArc.ts";
+import { CharacterIdea } from "@/types/ai/CharacterIdea.ts";
+
+/**
+ * Character names are used directly as Event Assembler identifiers --
+ * `Valeria`, `ValeriaMug`, `ValeriaPortrait`, `Valeria_NameText`,
+ * `ValeriaDeathText`, and so on. Nothing stops the story-arc model from
+ * reusing a name across chapters (the same name as a recruit in one
+ * chapter and a boss in another, say), and when that happens every
+ * derived definition is emitted twice. That shows up at ROM-build time
+ * as a pile of "Redefining Valeria" warnings and "Label already in
+ * scope, ignoring: ValeriaPortrait" -- and because the duplicate is
+ * *ignored* rather than merged, one of the two characters silently ends
+ * up wearing the other's portrait and stats.
+ *
+ * Duplicates are renamed rather than dropped, deliberately: chapter
+ * assembly looks up each chapter's boss with
+ * `allRomCharacters.find(c => c.chapterJoined === n && ...)!`, so
+ * removing a colliding boss would leave that lookup undefined and crash
+ * the run. Renaming keeps every chapter's cast intact while making the
+ * generated identifiers unique.
+ *
+ * Mutates and returns the given story arc, so every downstream consumer
+ * (character assembly, chapter events, dialogue prompts) sees the same
+ * consistent set of names.
+ */
+export default function ensureUniqueCharacterNames({
+  storyArc,
+  mainCharacterIdea,
+}: {
+  storyArc: StoryArc;
+  mainCharacterIdea: CharacterIdea;
+}): StoryArc {
+  // Compared case-insensitively: two names differing only in case would
+  // still be confusing, and some downstream consumers compare loosely.
+  const takenNames = new Set<string>([mainCharacterIdea.name.toLowerCase()]);
+
+  const makeUnique = (character: CharacterIdea, context: string): void => {
+    if (!takenNames.has(character.name.toLowerCase())) {
+      takenNames.add(character.name.toLowerCase());
+      return;
+    }
+
+    // Append a numeric suffix until the name is free. Kept
+    // letters-and-digits only so it stays a valid identifier, matching
+    // the constraint in CharacterIdeaSchema.
+    let suffix = 2;
+    let candidate = `${character.name}${suffix}`;
+    while (takenNames.has(candidate.toLowerCase())) {
+      suffix += 1;
+      candidate = `${character.name}${suffix}`;
+    }
+
+    console.warn(
+      `Duplicate character name "${character.name}" (${context}) renamed to "${candidate}" to keep generated identifiers unique.`
+    );
+    character.name = candidate;
+    takenNames.add(candidate.toLowerCase());
+  };
+
+  storyArc.chapterIdeas.forEach((chapterIdea, chapterIndex) => {
+    (chapterIdea.newPlayableCharacters || []).forEach((characterIdea) => {
+      makeUnique(characterIdea, `playable character in chapter ${chapterIndex}`);
+    });
+    makeUnique(chapterIdea.boss, `boss of chapter ${chapterIndex}`);
+  });
+
+  return storyArc;
+}
