new file mode 100644
index 00000000..860a2220
--- /dev/null
+++ b/server/map-processing/import-ported-tileset-terrain.ts
@@ -0,0 +1,105 @@
+import { join } from "node:path";
+import { PORTED_TILESETS } from "@/map-processing/ported-tilesets.ts";
+import getPathToRomBuilderDir from "@/fileIO/get-path-to-rom-builder-dir.ts";
+
+/**
+ * Regenerates lookup-tables/ported-tileset-terrain.ts from the ported
+ * tilesets' own mapchip config files.
+ *
+ * USAGE
+ *   deno task import-ported-tileset-terrain
+ *
+ * WHY NOT REUSE FEMapCreator's Tileset_Data.xml?
+ * Because these tilesets aren't in it. import-tileset-data.ts covers the
+ * 41 stock FE6/FE7/FE8 tilesets, which are identified by an 8-hex id
+ * embedded in their graphic name. The ported ones are custom builds with
+ * no such id, and three of the five are reworked rather than copied:
+ * matching their terrain against all 41 known tilesets scores
+ *
+ *   OutdoorSnowy    100.00%  FE6 - Snow
+ *   IndoorSnowy     100.00%  FE6 - Snow Castle
+ *   WesternIsles     89.06%  FE6 - Frontier
+ *   ImprovedCastle   70.21%  FE8 - Castle
+ *   DesertTemple     45.90%  FE8 - Desert
+ *
+ * So the two snowy sets could have borrowed FE6's terrain, but the other
+ * three would have had between 11% and 54% of their tiles mislabelled --
+ * forests read as walls, walls read as floor. Reading each tileset's own
+ * config avoids the guess entirely, and is authoritative besides: it's
+ * the same bytes the ROM will use at runtime.
+ *
+ * FORMAT
+ * A mapchip config is 0x2400 bytes: 0x2000 of tile composition data
+ * (1024 map tiles x 4 GBA tiles x 2 bytes) followed by 0x400 terrain
+ * tags, one byte per map tile. Verified by the two 100% matches above --
+ * the tail of OutdoorSnowy's config equals FE6 Snow's 1024 terrain tags
+ * exactly, tag for tag.
+ */
+
+const CONFIG_SIZE = 0x2400;
+const TERRAIN_TAG_COUNT = 0x400;
+
+/** Extracts the 1024 terrain tags from a mapchip config's trailing bytes. */
+export function terrainTagsFromConfig(config: Uint8Array): string {
+  if (config.length !== CONFIG_SIZE) {
+    throw new Error(
+      `expected a ${CONFIG_SIZE}-byte mapchip config, got ${config.length} bytes`
+    );
+  }
+  const tail = config.subarray(config.length - TERRAIN_TAG_COUNT);
+  return Array.from(tail).join(" ");
+}
+
+export default async function importPortedTilesetTerrain(): Promise<void> {
+  const tilesetsDir = join(getPathToRomBuilderDir(), "Maps", "Tilesets");
+
+  const rows: string[] = [];
+  for (const tileset of Object.values(PORTED_TILESETS)) {
+    const configPath = join(tilesetsDir, tileset.configFile);
+    let config: Uint8Array;
+    try {
+      config = await Deno.readFile(configPath);
+    } catch {
+      console.error(
+        `! ${tileset.id}: SKIPPED -- no config at ${tileset.configFile}`
+      );
+      continue;
+    }
+
+    const tags = terrainTagsFromConfig(config);
+    rows.push(
+      `  // ${tileset.origin} - ${tileset.label}\n` +
+        `  "${tileset.terrainConfigKey}": "${tags}",`
+    );
+    console.log(`+ ${tileset.id}: ${TERRAIN_TAG_COUNT} terrain tags`);
+  }
+
+  const output =
+    `// GENERATED by map-processing/import-ported-tileset-terrain.ts from the\n` +
+    `// ported tilesets' own .mapchip_config files. Do not edit by hand --\n` +
+    `// re-run the importer instead:\n` +
+    `//   deno task import-ported-tileset-terrain\n` +
+    `//\n` +
+    `// Each value is that tileset's 1024 terrain tags, one per map tile, in\n` +
+    `// the same order as lookup-tables/tileset-id-to-terrain.ts. Keyed by\n` +
+    `// ported tileset id rather than an 8-hex ROM id, because these\n` +
+    `// tilesets live in free space and have no hex index.\n` +
+    `\n` +
+    `/** Terrain tags keyed by ported tileset id. */\n` +
+    `const portedTilesetTerrain: Record<string, string> = {\n` +
+    rows.join("\n") +
+    `\n};\n` +
+    `\n` +
+    `export default portedTilesetTerrain;\n`;
+
+  const outPath = new URL(
+    "./lookup-tables/ported-tileset-terrain.ts",
+    import.meta.url
+  );
+  await Deno.writeTextFile(outPath, output);
+  console.log(`\nWrote ${rows.length} tileset(s) to ported-tileset-terrain.ts`);
+}
+
+if (import.meta.main) {
+  await importPortedTilesetTerrain();
+}
diff --git a/server/map-processing/import-tileset-data.ts b/server/map-processing/import-tileset-data.ts
new file mode 100644
index 00000000..6c9b3654
--- /dev/null
+++ b/server/map-processing/import-tileset-data.ts
@@ -0,0 +1,318 @@
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+/**
+ * Regenerates the terrain lookup tables from FEMapCreator's XML exports,
+ * so maps using FE6 and FE7 tilesets can be understood by the generation
+ * pipeline.
+ *
+ * USAGE
+ *   deno task import-tileset-data -- --tileset-data <path> --terrain-data <path>
+ *
+ * WHERE THE FILES COME FROM
+ * FEMapCreator ships `Tileset_Data.xml` and `Terrain_Data.xml`. The
+ * former lists, for every tileset, a `<Terrain_Tags>` array of 1024
+ * terrain IDs -- one per map tile -- which is exactly the shape of
+ * tile-config-to-terrain.ts. (That table's own comment says it was
+ * originally taken from this file by hand; this script does it for all
+ * tilesets instead of a few.)
+ *
+ * WHAT THIS DOES AND DOESN'T UNLOCK
+ * This is the GENERATION half only: it lets the AI read an FE6/FE7 map's
+ * terrain, reason about it, and place units sensibly. Actually RENDERING
+ * such a map still needs the tileset's graphics installed into the ROM --
+ * see ported-tilesets.ts and romBuilder/Maps/Tilesets/NewTilesets/.
+ * Importing terrain data for a tileset that isn't installed will let the
+ * map be parsed but it will still look wrong in-game, which is why
+ * import-maps.ts checks for the tileset .png separately.
+ */
+
+interface TilesetEntry {
+  name: string;
+  graphicName: string;
+  /** Full 8-hex tileset id, e.g. "16007718". */
+  fullId: string;
+  /** Last byte of the id -- the legacy key used by tile-config-to-terrain. */
+  configByte: string;
+  terrainTags: string;
+}
+
+function parseTilesetData(xml: string): TilesetEntry[] {
+  const entries: TilesetEntry[] = [];
+  const itemPattern =
+    /<Item>\s*<Key>(\d+)<\/Key>\s*<Value>([\s\S]*?)<\/Value>\s*<\/Item>/g;
+
+  for (const match of xml.matchAll(itemPattern)) {
+    const body = match[2];
+    const name = body.match(/<Name>(.*?)<\/Name>/)?.[1] ?? "";
+    const graphicName =
+      body.match(/<Graphic_Name>(.*?)<\/Graphic_Name>/)?.[1] ?? "";
+    const tags = body
+      .match(/<Terrain_Tags>([\s\S]*?)<\/Terrain_Tags>/)?.[1]
+      ?.trim()
+      .split(/\s+/);
+
+    if (!tags || tags.length === 0) continue;
+
+    // The 8 hex digits are embedded in the graphic name, e.g.
+    // "FE7 - Fort - 16007718". Tilesets without them are FEMapCreator's
+    // own custom sets, which have no ROM equivalent.
+    const fullId = graphicName.match(/\b([0-9a-fA-F]{8})\b/)?.[1];
+    if (!fullId) continue;
+
+    entries.push({
+      name,
+      graphicName,
+      fullId: fullId.toUpperCase(),
+      configByte: fullId.slice(-2).toUpperCase(),
+      terrainTags: tags.join(" "),
+    });
+  }
+  return entries;
+}
+
+function parseTerrainNames(xml: string): Map<number, string> {
+  const names = new Map<number, string>();
+  const itemPattern =
+    /<Item>\s*<Key>(\d+)<\/Key>\s*<Value>([\s\S]*?)<\/Value>\s*<\/Item>/g;
+  for (const match of xml.matchAll(itemPattern)) {
+    const id = parseInt(match[1], 10);
+    const name = match[2].match(/<Name>(.*?)<\/Name>/)?.[1]?.trim();
+    // "--" is FEMapCreator's label for the debug/no-terrain entry (id 0).
+    // It still needs a usable name, since real tilesets reference it.
+    if (name) names.set(id, name === "--" ? "None" : name);
+  }
+  return names;
+}
+
+/**
+ * Reads the ids and names already in terrain-id-to-name.ts, so
+ * regenerating it can't drop hand-curated entries that Terrain_Data.xml
+ * happens not to cover.
+ */
+async function readExistingTerrainNames(
+  path: string
+): Promise<Map<number, string>> {
+  const names = new Map<number, string>();
+  let source: string;
+  try {
+    source = await Deno.readTextFile(path);
+  } catch {
+    return names;
+  }
+  for (const match of source.matchAll(/^\s*(\d+):\s*"((?:[^"\\]|\\.)*)"/gm)) {
+    names.set(parseInt(match[1], 10), JSON.parse(`"${match[2]}"`));
+  }
+  return names;
+}
+
+function arg(args: string[], flag: string): string | null {
+  const i = args.indexOf(flag);
+  return i !== -1 && args[i + 1] ? args[i + 1] : null;
+}
+
+export default async function importTilesetData(
+  args: string[] = []
+): Promise<void> {
+  const tilesetDataPath = arg(args, "--tileset-data");
+  const terrainDataPath = arg(args, "--terrain-data");
+
+  if (!tilesetDataPath) {
+    console.error(
+      "Usage: deno task import-tileset-data -- --tileset-data <Tileset_Data.xml> [--terrain-data <Terrain_Data.xml>]"
+    );
+    Deno.exit(1);
+  }
+
+  const tilesets = parseTilesetData(await Deno.readTextFile(tilesetDataPath));
+  if (tilesets.length === 0) {
+    console.error(
+      "No tilesets with an 8-hex id found. Is this really FEMapCreator's Tileset_Data.xml?"
+    );
+    Deno.exit(1);
+  }
+  console.log(`Parsed ${tilesets.length} tilesets with ROM ids.`);
+
+  const lookupDir = join(
+    fileURLToPath(new URL(".", import.meta.url)),
+    "lookup-tables"
+  );
+
+  // --- tile-config-to-terrain -------------------------------------------
+  //
+  // Keyed by the FULL 8-hex id, because the last byte alone is ambiguous:
+  // FE7's Plains (01000703) and FE8's Fields (01000203) both end in "03".
+  // The legacy config-byte keys are kept as a fallback so existing maps,
+  // whose tileset names may only carry the trailing byte, still resolve.
+  const byFullId = tilesets
+    .map((t) => `  // ${t.name}\n  "${t.fullId}": "${t.terrainTags}",`)
+    .join("\n");
+
+  const seenByte = new Set<string>();
+  const byConfigByte: string[] = [];
+  for (const t of tilesets) {
+    // First writer wins, and FE8 sets are preferred for a contested byte
+    // since this ROM is FE8.
+    if (seenByte.has(t.configByte)) continue;
+    seenByte.add(t.configByte);
+    byConfigByte.push(`  "${t.configByte}": "${t.fullId}",`);
+  }
+  // Re-do preferring FE8 where a byte is contested.
+  const preferred = new Map<string, TilesetEntry>();
+  for (const t of tilesets) {
+    const existing = preferred.get(t.configByte);
+    if (
+      !existing ||
+      (!existing.name.startsWith("FE8") && t.name.startsWith("FE8"))
+    ) {
+      preferred.set(t.configByte, t);
+    }
+  }
+  const byConfigByteLines = [...preferred.entries()]
+    .sort()
+    .map(([byte, t]) => `  "${byte}": "${t.fullId}", // ${t.name}`)
+    .join("\n");
+
+  const tileConfigFile = `// GENERATED by map-processing/import-tileset-data.ts from
+// FEMapCreator's Tileset_Data.xml. Do not edit by hand -- re-run the
+// importer instead.
+//
+// Each value is the tileset's 1024 terrain tags, one per map tile.
+//
+// NOTE: terrain data lets the pipeline READ a map. Rendering an FE6/FE7
+// map in-game additionally requires its tileset to be installed into the
+// ROM -- see ported-tilesets.ts.
+
+import { findPortedTileset } from "@/map-processing/ported-tilesets.ts";
+import portedTilesetTerrain from "@/map-processing/lookup-tables/ported-tileset-terrain.ts";
+
+/** Terrain tags keyed by the FULL 8-hex tileset id. */
+const terrainTagsByTilesetId: Record<string, string> = {
+${byFullId}
+};
+
+/**
+ * Maps a bare tile-config byte to a full tileset id, for maps whose
+ * tileset name only carries the trailing byte. Ambiguous bytes resolve to
+ * the FE8 tileset, since that's the ROM being built -- e.g. "03" is both
+ * FE7 Plains and FE8 Fields, and FE8 wins.
+ */
+const tilesetIdByConfigByte: Record<string, string> = {
+${byConfigByteLines}
+};
+
+/**
+ * Looks up a tileset's terrain tags. Accepts a full 8-hex id (preferred,
+ * unambiguous), a bare config byte (legacy), or the name of a ported
+ * tileset. Returns null if unknown.
+ *
+ * Ported tilesets are checked FIRST and never fall through to the hex
+ * paths, because their names are not hex: "OutdoorSnowy".slice(-2) is
+ * "wy", which would just miss, and a name that happened to end in two
+ * hex-looking characters would silently match an unrelated tileset.
+ */
+export function getTerrainTags(tilesetIdOrConfigByte: string): string | null {
+  const ported = findPortedTileset(tilesetIdOrConfigByte);
+  if (ported) return portedTilesetTerrain[ported.terrainConfigKey] ?? null;
+
+  const key = tilesetIdOrConfigByte.toUpperCase();
+  if (terrainTagsByTilesetId[key]) return terrainTagsByTilesetId[key];
+  const viaByte = tilesetIdByConfigByte[key.slice(-2)];
+  return viaByte ? terrainTagsByTilesetId[viaByte] ?? null : null;
+}
+
+/** Every tileset id this build knows terrain data for. */
+export const KNOWN_TILESET_IDS = Object.keys(terrainTagsByTilesetId);
+
+export default terrainTagsByTilesetId;
+`;
+
+  await Deno.writeTextFile(
+    join(lookupDir, "tileset-id-to-terrain.ts"),
+    tileConfigFile
+  );
+  console.log(
+    `Wrote lookup-tables/tileset-id-to-terrain.ts (${tilesets.length} tilesets, ${preferred.size} config-byte fallbacks).`
+  );
+
+  // --- terrain-id-to-name -----------------------------------------------
+  //
+  // This used to write `terrain-id-to-name.generated.ts`, which NOTHING
+  // imported -- the pipeline reads `terrain-id-to-name.ts`, the
+  // hand-written table. So running this importer appeared to fix the
+  // missing terrain names and silently changed nothing, leaving 26 of
+  // the 41 stock tilesets with tiles the placement AI sees only as
+  // "Unknown Terrain 39". It now writes the real file.
+  //
+  // The existing table is merged in rather than replaced: it is
+  // hand-curated (e.g. it maps both 26 and 27 to "Wall"), so an id that
+  // Terrain_Data.xml doesn't name keeps whatever name it already had
+  // instead of regressing to a placeholder.
+  if (terrainDataPath) {
+    const names = parseTerrainNames(await Deno.readTextFile(terrainDataPath));
+
+    const existing = await readExistingTerrainNames(
+      join(lookupDir, "terrain-id-to-name.ts")
+    );
+    for (const [id, name] of existing) {
+      if (!names.has(id) && !/^Unknown Terrain /.test(name)) names.set(id, name);
+    }
+
+    // Any terrain id actually referenced by a tileset but absent from
+    // Terrain_Data.xml still needs a name -- otherwise it resolves to
+    // undefined and silently produces tiles with no terrain, which the
+    // placement AI then can't reason about. Give them a stable
+    // placeholder rather than leaving a hole.
+    const used = new Set<number>();
+    for (const t of tilesets) {
+      for (const tag of t.terrainTags.split(" ")) used.add(parseInt(tag, 10));
+    }
+    const unnamed = [...used].filter((id) => !names.has(id)).sort((a, b) => a - b);
+    for (const id of unnamed) names.set(id, `Unknown Terrain ${id}`);
+
+    const lines = [...names.entries()]
+      .sort((a, b) => a[0] - b[0])
+      .map(([id, name]) => `  ${id}: ${JSON.stringify(name)},`)
+      .join("\n");
+
+    const terrainFile = `// GENERATED by map-processing/import-tileset-data.ts from
+// FEMapCreator's Terrain_Data.xml, merged with any hand-curated names
+// already present. Do not edit by hand -- re-run the importer instead:
+//   deno task import-tileset-data -- --tileset-data <path> --terrain-data <path>
+//
+// Ids referenced by a tileset but missing from Terrain_Data.xml are given
+// a "Unknown Terrain N" placeholder so they still resolve to something --
+// previously they came back undefined, leaving tiles the placement AI
+// couldn't reason about.
+
+const terrainIdToName: Record<number, string> = {
+${lines}
+};
+
+export default terrainIdToName;
+`;
+    await Deno.writeTextFile(
+      join(lookupDir, "terrain-id-to-name.ts"),
+      terrainFile
+    );
+    console.log(
+      `Wrote lookup-tables/terrain-id-to-name.ts (${names.size} terrain types, ${unnamed.length} placeholders for ids missing from Terrain_Data.xml: ${unnamed.join(", ")}).`
+    );
+  } else {
+    console.log(
+      "\nNo --terrain-data given, so terrain NAMES were not refreshed. 26 of the\n" +
+        "41 stock tilesets use terrain ids that the current table doesn't name\n" +
+        "(39, 40, 41, 24, 47, 9, 20, 28, 36, 42, 49, 58, 59, 84), and those tiles\n" +
+        'reach the placement AI as "Unknown Terrain N". Re-run with\n' +
+        "--terrain-data <FEMapCreator/Terrain_Data.xml> to fill them in."
+    );
+  }
+
+  console.log(
+    "\nDone. Note: terrain data alone lets the AI READ these maps. Rendering an FE6/FE7 map in-game still needs its tileset installed into the ROM -- see ported-tilesets.ts."
+  );
+}
+
+if (import.meta.main) {
+  await importTilesetData(Deno.args);
+}
