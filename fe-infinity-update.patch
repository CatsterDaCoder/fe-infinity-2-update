diff --git a/server/ai/assemble-chapter-event/unit-placement/filter-weapons-by-level.ts b/server/ai/assemble-chapter-event/unit-placement/filter-weapons-by-level.ts
new file mode 100644
index 00000000..4f541e6f
--- /dev/null
+++ b/server/ai/assemble-chapter-event/unit-placement/filter-weapons-by-level.ts
@@ -0,0 +1,72 @@
+/**
+ * FE8 weapons have ranks (E through S). A level 1 Soldier can't actually
+ * use a Silver Lance -- it needs rank A -- so handing one out produces a
+ * unit standing there with a weapon it can't equip. Nothing previously
+ * filtered the weapon list by the unit's level: `generateInventory` was
+ * shown every weapon of the right *type* regardless of rank, so early
+ * enemies routinely got Silver/Brave/Killer-tier gear.
+ *
+ * Rather than encode the full rank table (which also depends on class
+ * and growth), weapons are bucketed into rough tiers by the level at
+ * which a unit would plausibly have the rank for them. This keeps early
+ * chapters using Iron/basic gear and lets stronger weapons appear as
+ * levels climb.
+ */
+
+/** Minimum unit level before a weapon becomes available. */
+const TIER_MIN_LEVEL = {
+  basic: 1,
+  mid: 6,
+  high: 11,
+  elite: 16,
+} as const;
+
+// Matched against the weapon name. Order matters: first match wins.
+const TIER_PATTERNS: { pattern: RegExp; tier: keyof typeof TIER_MIN_LEVEL }[] = [
+  // Elite: legendary/S-rank and the strongest specials.
+  {
+    pattern:
+      /^(Audhulma|Excalibur|Garm|Gleipnir|Ivaldi|Latona|Nidhogg|Sieglinde|Siegmund|Vidofnir|Naglfar|Fenrir|Purge|Aura|Eclipse)/i,
+    tier: "elite",
+  },
+  // High: Silver tier, brave/killer specials, effective weapons, staves
+  // that matter late.
+  {
+    pattern:
+      /^(Silver|Brave|Killer|Killing|Rune|Devil|Toxin|Shamshir|Wind ?Sword|Light ?Brand|Spear|Tomahawk|Horseslayer|Lanceslayer|Swordslayer|Halberd|Hammer|Bolting|Physic|Fortify|Berserk|Sleep|Silence|Warp|Rescue|Barrier|Dragonspear|Short ?Spear|Long ?Bow|Wyrmslayer|Zanbato|Bolt ?Axe)/i,
+    tier: "high",
+  },
+  // Mid: Steel tier and second-rank magic.
+  {
+    pattern:
+      /^(Steel|Thunder|Elfire|Nosferatu|Shine|Divine|Mend|Recover|Poison|Heavy ?Spear|Hand ?Axe|Javelin|Iron ?Blade|Steel ?Blade|Armorslayer|Torch|Unlock|Restore)/i,
+    tier: "mid",
+  },
+];
+
+function getWeaponMinLevel(weaponName: string): number {
+  for (const { pattern, tier } of TIER_PATTERNS) {
+    if (pattern.test(weaponName)) {
+      return TIER_MIN_LEVEL[tier];
+    }
+  }
+  // Iron/Slim/Fire/Flux/Heal/Vulnerary and anything unrecognized.
+  return TIER_MIN_LEVEL.basic;
+}
+
+/**
+ * Narrows a weapon list to what a unit at `level` could plausibly use.
+ * Never returns an empty list -- if nothing qualifies (unusual, but
+ * possible for a sparse weapon type), the lowest-tier options are
+ * returned so the unit still gets something it can hold.
+ */
+export default function filterWeaponsByLevel(
+  weapons: string[],
+  level: number
+): string[] {
+  const usable = weapons.filter((w) => getWeaponMinLevel(w) <= level);
+  if (usable.length > 0) return usable;
+
+  const lowest = Math.min(...weapons.map(getWeaponMinLevel));
+  return weapons.filter((w) => getWeaponMinLevel(w) === lowest);
+}
