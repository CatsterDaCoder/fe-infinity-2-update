+// Central registry of every system prompt used by the AI generation pipeline.
+//
+// This is the single source of truth for prompt text. Each `ai/*.ts` file
+// that used to hardcode its own system prompt now pulls it from here (via
+// `getPrompt` in `prompt-store.ts`), which means:
+//   1. The Web UI can list, display, and let a user edit every prompt.
+//   2. Edits are saved as overrides (see prompt-overrides.json) without
+//      touching this file, so `deno task webui` always has a "Reset to
+//      default" available.
+//
+// A prompt's `template` may contain `{{variableName}}` placeholders for the
+// handful of prompts that need a runtime value spliced into the
+// instructions (e.g. the number of chapters). Everything else is static
+// instructional text -- the actual per-request data is passed separately as
+// the "prompt"/user message, which is NOT editable here since it's just a
+// JSON dump of whatever was generated so far.
+
+export interface PromptDefinition {
+  /** Stable identifier. Do not change once shipped -- it's used as the key
+   * in prompt-overrides.json, so renaming it would silently drop a user's
+   * customization. */
+  id: string;
+  /** Human readable name shown in the Web UI. */
+  label: string;
+  /** One-line explanation of what this prompt controls, shown in the UI. */
+  description: string;
+  /** Which stage of the pipeline this belongs to, for grouping in the UI. */
+  group:
+    | "World & Story"
+    | "Characters"
+    | "Maps & Unit Placement"
+    | "Chapter Events & Dialogue"
+    | "Portraits";
+  /** The source file this prompt originally lived in, shown in the UI so
+   * developers can find it. */
+  sourceFile: string;
+  /** Default system prompt text. May contain {{placeholders}}. */
+  template: string;
+}
+
+function def(d: PromptDefinition): PromptDefinition {
+  return d;
+}
+
+export const PROMPTS = {
+  worldSummary: def({
+    id: "world-summary",
+    label: "World Summary",
