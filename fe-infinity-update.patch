diff --git a/server/map-processing/import-maps.ts b/server/map-processing/import-maps.ts
new file mode 100644
index 00000000..6f5fb69f
--- /dev/null
+++ b/server/map-processing/import-maps.ts
@@ -0,0 +1,262 @@
+import { join, basename } from "node:path";
+import { fileURLToPath } from "node:url";
+import defineMapAreas from "@/map-processing/ai/define-map-areas.ts";
+import deriveMapAreas from "@/map-processing/derive-map-areas.ts";
+import writeMapData from "@/map-processing/fileIO/write-map-data.ts";
+import writeAllMapOptions from "@/map-processing/fileIO/write-all-map-options.ts";
+import getInfoFromTmx from "@/map-processing/get-info-from-tmx/get-info-from-tmx.ts";
+import prepareTmx from "@/map-processing/prepare-tmx.ts";
+import {
+  PORTED_TILESETS,
+  describePortedTilesets,
+  findPortedTileset,
+} from "@/map-processing/ported-tilesets.ts";
+import getPathWithinAssetsDir from "@/fileIO/get-path-within-assets-dir.ts";
+import getPathToRomBuilderDir from "@/fileIO/get-path-to-rom-builder-dir.ts";
+import { MapData } from "@/map-processing/types/MapData.ts";
+
+/**
+ * Imports new maps so the AI can pick them when generating chapters.
+ *
+ * USAGE
+ *   deno task import-maps                     # imports from map-processing/maps-to-import/
+ *   deno task import-maps -- --dir /some/path # imports from somewhere else
+ *   deno task import-maps -- --use-ai         # describe areas with an OpenAI vision model
+ *   deno task import-maps -- --force          # re-import maps that already exist
+ *
+ * WHAT IT ACCEPTS
+ * Tiled `.tmx` files. That's the only map format this toolchain handles --
+ * the ROM build runs them through tmx2ea, which is Tiled-only. A matching
+ * `.png` next to the `.tmx` is optional and only used if you pass
+ * --use-ai.
+ *
+ * A map's tileset is identified either by:
+ *
+ *   - an 8-hex-character name (e.g. "3C00CE3E"), which is a stock FE8
+ *     tileset and must have a matching
+ *     romBuilder/Maps/Tilesets/<NAME>.png; or
+ *   - the name of a PORTED tileset (see ported-tilesets.ts), which lives
+ *     in free space under named symbols rather than at a hex index.
+ *
+ * Ported tilesets used to be rejected here before prepare-tmx.ts ever saw
+ * them, because the hex check ran unconditionally -- which made
+ * findPortedTileset() unreachable and meant no FE6/FE7-tileset map could
+ * ever be imported. Ported tilesets are now checked first.
+ *
+ * Maps referencing a tileset that isn't present are rejected up front
+ * rather than being allowed through to produce a visually broken chapter.
+ */
+
+const TILESET_NAME_PATTERN = /^[0-9A-Fa-f]{8}$/;
+
+function parseArgs(args: string[]) {
+  return {
+    dir:
+      args.includes("--dir") && args[args.indexOf("--dir") + 1]
+        ? args[args.indexOf("--dir") + 1]
+        : null,
+    useAi: args.includes("--use-ai"),
+    force: args.includes("--force"),
+  };
+}
+
+async function fileExists(path: string): Promise<boolean> {
+  try {
+    await Deno.stat(path);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export default async function importMaps(args: string[] = []): Promise<void> {
+  const { dir, useAi, force } = parseArgs(args);
+
+  const importDir =
+    dir ??
+    join(fileURLToPath(new URL(".", import.meta.url)), "maps-to-import");
+
+  await Deno.mkdir(importDir, { recursive: true });
+
+  const tmxFiles: string[] = [];
+  for await (const entry of Deno.readDir(importDir)) {
+    if (entry.isFile && entry.name.toLowerCase().endsWith(".tmx")) {
+      tmxFiles.push(join(importDir, entry.name));
+    }
+  }
+
+  if (tmxFiles.length === 0) {
+    console.log(`No .tmx files found in ${importDir}`);
+    console.log(
+      "Drop Tiled .tmx map files in there and re-run. Other formats (.map, .mar, .fmp) aren't supported -- open them in Tiled and save as .tmx first."
+    );
+    return;
+  }
+
+  console.log(`Found ${tmxFiles.length} .tmx file(s) in ${importDir}\n`);
+
+  const tilesetsDir = join(getPathToRomBuilderDir(), "Maps", "Tilesets");
+
+  // The tilesets actually installed in the ROM. Any map whose tileset
+  // isn't one of these can't be rendered, so listing them makes a
+  // rejection actionable instead of just a "no".
+  const availableTilesets: string[] = [];
+  try {
+    for await (const entry of Deno.readDir(tilesetsDir)) {
+      if (entry.isFile && entry.name.toLowerCase().endsWith(".png")) {
+        availableTilesets.push(entry.name.replace(/\.png$/i, ""));
+      }
+    }
+    availableTilesets.sort();
+  } catch {
+    // Directory missing -- the per-map check below reports it.
+  }
+
+  // Which ported tilesets are actually registered in the ROM. Reading
+  // the installer rather than trusting the registry means a tileset that
+  // was removed from the build gets a clear rejection instead of an
+  // "Undefined identifier: <Something>ObjectSet" at assembly time.
+  const installedPortedIds = new Set<string>();
+  try {
+    const installer = await Deno.readTextFile(
+      join(tilesetsDir, "NewTilesets", "TilesetInstaller.event")
+    );
+    for (const tileset of Object.values(PORTED_TILESETS)) {
+      const registered = new RegExp(
+        `EventPointerTable\\s*\\(\\s*${tileset.objectSetSymbol}\\s*,`,
+        "i"
+      ).test(installer);
+      if (registered) installedPortedIds.add(tileset.id);
+    }
+  } catch {
+    // No installer -- ported tilesets simply aren't available.
+  }
+
+  let imported = 0;
+  let skipped = 0;
+
+  for (const tmxPath of tmxFiles) {
+    const mapName = basename(tmxPath, ".tmx");
+    const outputYaml = getPathWithinAssetsDir(`maps/${mapName}.yaml`);
+
+    if (!force && (await fileExists(outputYaml))) {
+      console.log(`- ${mapName}: already imported (use --force to redo)`);
+      skipped++;
+      continue;
+    }
+
+    try {
+      const rawTmx = await Deno.readTextFile(tmxPath);
+      const {
+        tileset,
+        height,
+        width,
+        terrainGrid,
+        pointsOfInterest,
+        interactableTiles,
+      } = getInfoFromTmx(rawTmx);
+
+      // A ported FE6/FE7 tileset has no hex index at all -- it's
+      // installed into free space and referenced by symbol -- so it must
+      // be resolved BEFORE the hex check, which would otherwise reject
+      // every map that uses one.
+      const ported = findPortedTileset(tileset);
+
+      if (ported) {
+        if (!installedPortedIds.has(ported.id)) {
+          throw new Error(
+            `needs ported tileset "${ported.id}", which isn't registered in ` +
+              `romBuilder/Maps/Tilesets/NewTilesets/TilesetInstaller.event.\n` +
+              `    Registered there: ${[...installedPortedIds].join(", ") || "(none)"}`
+          );
+        }
+      } else {
+        // The tileset name is sliced up into ObjectType/PaletteID/
+        // TileConfig hex values by prepareTmx, so a non-hex name would
+        // silently produce garbage rather than failing -- check it here.
+        if (!TILESET_NAME_PATTERN.test(tileset)) {
+          throw new Error(
+            `tileset is named "${tileset}", but it must be either exactly 8 hex characters ` +
+              `(e.g. "3C00CE3E") or the name of a ported tileset.\n` +
+              `    Ported tilesets available: ${describePortedTilesets()}\n` +
+              `    Open the .tmx in Tiled and rename the tileset to match its ROM ` +
+              `object/palette/config IDs, or to one of the ported names above.`
+          );
+        }
+
+        const tilesetPng = join(tilesetsDir, `${tileset}.png`);
+        if (!(await fileExists(tilesetPng))) {
+          throw new Error(
+            `needs tileset "${tileset}", which isn't installed in this ROM.\n` +
+              `    Installed stock tilesets: ${availableTilesets.join(", ")}\n` +
+              `    Ported tilesets: ${describePortedTilesets()}\n` +
+              `    If this map is from FE6 or FE7, its tileset doesn't exist in an FE8 ROM at all. ` +
+              `Either rename the tileset in Tiled to one of the ported names above, or port it in ` +
+              `(see romBuilder/Maps/Tilesets/NewTilesets/TilesetInstaller.event). ` +
+              `Otherwise, copy ${tileset}.png into romBuilder/Maps/Tilesets/.`
+          );
+        }
+      }
+
+      const finalTmx = prepareTmx({ mapName, tmx: rawTmx, tileset });
+
+      let description: string;
+      let areas;
+      if (useAi) {
+        ({ description, areas } = await defineMapAreas({
+          width,
+          height,
+          terrainGrid,
+          pointsOfInterest,
+          mapName,
+          tmx: finalTmx,
+        }));
+      } else {
+        ({ description, areas } = deriveMapAreas({
+          width,
+          height,
+          terrainGrid,
+          pointsOfInterest,
+        }));
+      }
+
+      const mapData: MapData = {
+        name: mapName,
+        description,
+        tmx: finalTmx,
+        height,
+        width,
+        terrainGrid,
+        pointsOfInterest,
+        interactableTiles,
+        areas,
+      };
+
+      await writeMapData(mapData);
+      console.log(
+        `+ ${mapName}: ${width}x${height}, tileset ${tileset}, ${areas.length} areas, ${pointsOfInterest.length} points of interest`
+      );
+      imported++;
+    } catch (err) {
+      console.error(
+        `! ${mapName}: SKIPPED -- ${err instanceof Error ? err.message : err}`
+      );
+      skipped++;
+    }
+  }
+
+  if (imported > 0) {
+    // Rebuilds all-map-options.ts from every map yaml, which is what the
+    // generation pipeline actually reads.
+    await writeAllMapOptions();
+    console.log(
+      `\nImported ${imported} map(s). all-map-options.ts regenerated -- they're now in the pool the AI picks from.`
+    );
+  } else {
+    console.log(`\nNo new maps imported (${skipped} skipped).`);
+  }
+}
+
+if (import.meta.main) {
+  await importMaps(Deno.args);
+}
