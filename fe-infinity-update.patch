--- a/romBuilder/AssembleAll.sh
+++ b/romBuilder/AssembleAll.sh
@@ -15,45 +15,74 @@ echo "-----------------------------------"
 # Trap SIGINT (Ctrl+C) and kill all background processes
 trap 'kill 0' SIGINT
 
+pids=()
+names=()
+
 # Assemble autogenerated definitions in parallel
 echo "Assembling autogenerated definitions..."
 cd "$currDir"
-./AssembleDefs.sh &
+bash "$currDir/AssembleDefs.sh" &
+pids+=("$!"); names+=("AssembleDefs.sh")
 
 # Assemble graphics in parallel
 echo "Assembling graphics..."
 cd "$currDir"
-./AssembleGraphics.sh &
+bash "$currDir/AssembleGraphics.sh" &
+pids+=("$!"); names+=("AssembleGraphics.sh")
 
 # Assemble tables in parallel
 echo "Assembling tables..."
 cd "$currDir"
-./AssembleTables.sh &
+bash "$currDir/AssembleTables.sh" &
+pids+=("$!"); names+=("AssembleTables.sh")
 
 # Assemble text in parallel
 echo "Assembling text..."
 cd "$currDir"
-./AssembleText.sh &
+bash "$currDir/AssembleText.sh" &
+pids+=("$!"); names+=("AssembleText.sh")
 
 # Assemble music in parallel
 echo "Assembling music..."
 cd "$currDir"
-./AssembleMusic.sh noRefs &
+bash "$currDir/AssembleMusic.sh" noRefs &
+pids+=("$!"); names+=("AssembleMusic.sh")
 
 # Assemble maps in parallel
 echo "Assembling maps..."
 cd "$currDir"
-./AssembleMaps.sh &
+bash "$currDir/AssembleMaps.sh" &
+pids+=("$!"); names+=("AssembleMaps.sh")
+
+# `wait` alone only blocks until every job finishes -- it doesn't tell you
+# whether any of them actually failed. A failure in, say, AssembleMaps.sh
+# (a missing `wine`/`mono` install, an incompatible tool version, ...)
+# used to pass completely silently, and the build would carry on to
+# MAKEHACK.sh with stale or incomplete data, occasionally even reporting
+# "ROM built successfully" over a ROM that was missing whatever the failed
+# step was supposed to produce. Check each job's exit code individually
+# and stop with a specific, actionable message if any of them failed.
+failed=0
+for i in "${!pids[@]}"; do
+  if ! wait "${pids[$i]}"; then
+    echo "❌ ${names[$i]} failed (see its output above for the actual error)."
+    failed=1
+  fi
+done
 
-# Wait for all parallel jobs to finish
-wait
+if [ "$failed" -eq 1 ]; then
+  echo "-----------------------------------"
+  echo "Aborting: one or more asset-assembly steps failed. Not continuing to the final ROM build."
+  echo "-----------------------------------"
+  exit 1
+fi
 
 # Make animations
 cd "$currDir"
 echo "Making animations..."
-./MAKEAnims.sh
+bash "$currDir/makeAnims.sh"
 
 # Final make
 cd "$currDir"
 echo "Final make..."
-./MAKEHACK.sh noPause noSaveCopy
+bash "$currDir/MAKEHACK.sh" noPause noSaveCopy
