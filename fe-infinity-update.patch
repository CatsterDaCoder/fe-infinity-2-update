+// `name="Main"` as the FIRST attribute, so it found no layer, injected NO
+// properties, and tmx2ea fell back to its documented literal defaults --
+// "ChapterID", "ObjectType", "PaletteID", "TileConfig", "map_id" -- none
+// of which are ROM symbols. Hence the build failing with
+// "Undefined identifier: ChapterID" and friends.
+// ---------------------------------------------------------------------
+
+const MODERN_TMX = `<?xml version="1.0" encoding="UTF-8"?>
+<map version="1.9" tiledversion="1.9.2" orientation="orthogonal" renderorder="right-down" width="2" height="2" tilewidth="16" tileheight="16" infinite="0" nextlayerid="3" nextobjectid="1">
