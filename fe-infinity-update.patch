@@ -0,0 +1,92 @@
+import {
+  PORTED_TILESETS,
+  findPortedTileset,
+} from "@/map-processing/ported-tilesets.ts";
+import portedTilesetTerrain from "@/map-processing/lookup-tables/ported-tileset-terrain.ts";
+import { getTerrainTags } from "@/map-processing/lookup-tables/tileset-id-to-terrain.ts";
+import prepareTmx from "@/map-processing/prepare-tmx.ts";
+import { assertEquals } from "@std/assert";
+
+Deno.test("findPortedTileset matches words in any order", () => {
+  // A plain substring test was not enough: once punctuation is stripped,
+  // "FE6 Snowy Outdoor" does not contain "outdoorsnowy".
+  assertEquals(findPortedTileset("OutdoorSnowy")?.id, "OutdoorSnowy");
+  assertEquals(findPortedTileset("Outdoor Snowy")?.id, "OutdoorSnowy");
+  assertEquals(findPortedTileset("FE6 Snowy Outdoor")?.id, "OutdoorSnowy");
+  assertEquals(findPortedTileset("FE6 - Snowy - Outdoor")?.id, "OutdoorSnowy");
+  assertEquals(findPortedTileset("FE6 Snowy Indoor")?.id, "IndoorSnowy");
+  assertEquals(
+    findPortedTileset("FE7 Western Isles Extended")?.id,
+    "WesternIsles"
+  );
+});
+
+Deno.test("findPortedTileset does not claim stock tilesets", () => {
+  // Requiring ALL of an id's words is what keeps this from over-matching.
+  for (const name of ["3C00CE3E", "01000203", "FE8 - Castle", "FE6 - Snow", "Castle", ""]) {
+    assertEquals(findPortedTileset(name), null, `${name} should not match`);
+  }
+});
+
+Deno.test("every ported tileset has 1024 terrain tags", () => {
+  for (const tileset of Object.values(PORTED_TILESETS)) {
+    const tags = portedTilesetTerrain[tileset.terrainConfigKey];
+    assertEquals(typeof tags, "string", `${tileset.id} has no terrain`);
+    assertEquals(tags.split(" ").length, 1024, `${tileset.id} tag count`);
+  }
+});
+
+Deno.test("getTerrainTags resolves ported tilesets", () => {
+  // Before this, "OutdoorSnowy".slice(-2) === "wy" fell through every
+  // hex path and returned null, so importing the map threw "tile config
+  // is not a known FE8 tile configuration".
+  for (const tileset of Object.values(PORTED_TILESETS)) {
+    assertEquals(
+      getTerrainTags(tileset.id),
+      portedTilesetTerrain[tileset.terrainConfigKey],
+      tileset.id
+    );
+  }
+  assertEquals(
+    getTerrainTags("FE6 Snowy Outdoor"),
+    getTerrainTags("OutdoorSnowy")
+  );
+});
+
+Deno.test("getTerrainTags still resolves stock tilesets", () => {
+  assertEquals(typeof getTerrainTags("3C00CE3E"), "string");
+  assertEquals(typeof getTerrainTags("3E"), "string");
+  assertEquals(getTerrainTags("NotATileset"), null);
+});
+
+Deno.test("prepareTmx emits symbols for ported, hex for stock", () => {
+  const tmx = `<?xml version="1.0" encoding="UTF-8"?>
+<map version="1.9" orientation="orthogonal" width="2" height="2" tilewidth="16" tileheight="16">
+ <tileset firstgid="1" name="OutdoorSnowy" tilewidth="16" tileheight="16">
+  <image source="x.png" width="512" height="512"/>
+ </tileset>
+ <layer id="1" name="Tile Layer 1"><data encoding="csv">1,2,3,4</data></layer>
+</map>`;
+
+  const ported = prepareTmx({ tmx, mapName: "SnowPass", tileset: "OutdoorSnowy" });
+  for (const prop of [
+    '<property name="ObjectType" value="OutdoorSnowyObjectSet"/>',
+    '<property name="PaletteID" value="OutdoorSnowyPalette"/>',
+    '<property name="TileConfig" value="OutdoorSnowyTileConfig"/>',
+    '<property name="MapID" value="SnowPass_Map"/>',
+  ]) {
+    assertEquals(ported.includes(prop), true, `missing ${prop}`);
+  }
+  // A named symbol must NOT be given a 0x prefix.
+  assertEquals(ported.includes("0xOutdoor"), false);
+
+  const stock = prepareTmx({
+    tmx: tmx.replace('name="OutdoorSnowy"', 'name="3C00CE3E"'),
+    mapName: "Knights10",
+    tileset: "3C00CE3E",
+  });
+  assertEquals(stock.includes('<property name="ObjectType" value="0x3C"/>'), true);
+  assertEquals(stock.includes('<property name="PaletteID" value="0xCE"/>'), true);
+  assertEquals(stock.includes('<property name="TileConfig" value="0x3E"/>'), true);
+  assertEquals(stock.includes('<property name="Anims" value="_3CAnims"/>'), true);
+});
