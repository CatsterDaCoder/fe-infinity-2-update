diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 00000000..41a80606
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,9 @@
+# Windows Git commonly defaults to `core.autocrlf=true`, which silently
+# rewrites LF line endings to CRLF on checkout. A CRLF-corrupted shebang
+# line (`#!/bin/bash` + a trailing \r) makes the kernel look for an
+# interpreter literally named `/bin/bash\r`, which doesn't exist -- the
+# exact cause of the "cannot execute: required file not found" errors
+# these scripts have hit on Windows/WSL checkouts. `eol=lf` here overrides
+# a contributor's autocrlf setting for these specific paths, so a fresh
+# clone gets clean LF endings no matter how their global Git is configured.
+*.sh text eol=lf
