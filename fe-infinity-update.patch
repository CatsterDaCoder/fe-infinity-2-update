+++ b/server/map-processing/ported-tilesets.ts
@@ -0,0 +1,210 @@
+/**
+ * Tilesets that have been PORTED into the ROM, as opposed to the stock
+ * FE8 ones.
+ *
+ * Background: a stock FE8 map identifies its tileset with 8 hex digits
+ * (e.g. "3C00CE3E" = ObjectType 0x3C, PaletteID 0xCE, TileConfig 0x3E).
+ * Those are indices into data that already exists in an FE8 ROM, so
+ * prepare-tmx.ts can just slice the hex apart and write it into the map's
+ * properties.
+ *
+ * FE6/FE7 tilesets don't exist in an FE8 ROM at all, so there's no index
+ * to point at. They have to be installed into free space first -- see
+ * romBuilder/Maps/Tilesets/NewTilesets/TilesetInstaller.event, which
+ * registers each ported tileset's graphics, palette and tile config under
+ * named symbols via EventPointerTable(). Maps then reference those
+ * NAMES rather than hex indices.
+ *
+ * Adding an entry here tells prepare-tmx.ts to emit the named symbols for
+ * that tileset instead of slicing hex out of its name.
+ *
+ * The five tilesets below ship with this repo already -- their graphics
+ * and palettes are in NewTilesets/ and they're registered in
+ * TilesetInstaller.event -- but they were only half-installed:
+ *
+ *   1. Their `.mapchip_config.dmp` tile configs were 0-byte files.
+ *      AssembleNewTilesets.sh, which generates them, carries the comment
+ *      "because they aren't [changing] I'm not running it for now", and
+ *      a `> out.dmp` redirect creates the file even when the command
+ *      never runs. So TilesetInstaller.event was #incbin-ing nothing and
+ *      every ported tileset had an empty tile configuration.
+ *   2. import-maps.ts rejected any tileset name that wasn't 8 hex
+ *      characters, before findPortedTileset() was ever consulted -- so
+ *      no map using one could be imported in the first place.
+ *   3. Nothing knew their terrain, so even a map that got through would
+ *      have thrown "tile config is not a known FE8 tile configuration".
+ *
+ * All three are fixed: the configs are generated and verified to
+ * round-trip through GBA LZ77, the import path checks ported tilesets
+ * first, and terrain is read out of each tileset's own config (see
+ * lookup-tables/ported-tileset-terrain.ts).
+ */
+
+export interface PortedTileset {
+  /** Identifier used in a .tmx tileset name to select this tileset. */
+  id: string;
+  /** Human-readable name, used in import messages. */
+  label: string;
+  /** Which game the tileset came from. */
+  origin: "FE6" | "FE7" | "FE8";
+  /**
+   * The tileset's source art, relative to romBuilder/Maps/Tilesets/.
+   * Only used so the .tmx's <image source=...> points at something real
+   * when the map is opened in Tiled -- tmx2ea never reads the image, it
+   * only reads layer data and properties.
+   */
+  previewPng: string;
+  /**
+   * The tileset's mapchip config, relative to romBuilder/Maps/Tilesets/.
+   * This is the authoritative source of the tileset's terrain: its last
+   * 0x400 bytes are the 1024 terrain tags, one per map tile. See
+   * import-ported-tileset-terrain.ts.
+   */
+  configFile: string;
+  /** Symbol registered via EventPointerTable for the object graphics. */
+  objectSetSymbol: string;
+  /** Symbol registered via EventPointerTable for the palette. */
+  paletteSymbol: string;
+  /** Symbol registered via EventPointerTable for the tile config. */
+  tileConfigSymbol: string;
+  /** Symbol for tile animations, or null if the tileset has none. */
+  animsSymbol: string | null;
+  /**
+   * Key into lookup-tables/ported-tileset-terrain.ts giving this
+   * tileset's 1024 terrain tags.
+   *
+   * These are read from the tileset's OWN configFile rather than copied
+   * from whichever stock tileset it resembles, because three of the five
+   * are reworked: matching their terrain against all 41 known tilesets
+   * scores 100% for OutdoorSnowy (FE6 Snow) and IndoorSnowy (FE6 Snow
+   * Castle), but only 89% for WesternIsles, 70% for ImprovedCastle and
+   * 46% for DesertTemple. Borrowing a lookalike's terrain would mislabel
+   * up to half their tiles.
+   */
+  terrainConfigKey: string;
+}
+
+export const PORTED_TILESETS: Record<string, PortedTileset> = {
+  DesertTemple: {
+    id: "DesertTemple",
+    label: "Desert Temple / Bastion",
+    origin: "FE6",
+    previewPng: "NewTilesets/DesertTemple.png",
+    configFile: "NewTilesets/DesertTemple.mapchip_config",
+    objectSetSymbol: "DesertTempleObjectSet",
+    paletteSymbol: "DesertTemplePalette",
+    tileConfigSymbol: "DesertTempleTileConfig",
+    animsSymbol: null,
+    terrainConfigKey: "DesertTemple",
+  },
+  OutdoorSnowy: {
+    id: "OutdoorSnowy",
+    label: "Snowy Outdoor",
+    origin: "FE6",
+    previewPng: "NewTilesets/OutdoorSnowy.png",
+    configFile: "NewTilesets/SnowyTilesetOutdoorTileConfiguration.mapchip_config",
+    objectSetSymbol: "OutdoorSnowyObjectSet",
+    paletteSymbol: "OutdoorSnowyPalette",
+    tileConfigSymbol: "OutdoorSnowyTileConfig",
+    animsSymbol: null,
+    terrainConfigKey: "OutdoorSnowy",
+  },
+  IndoorSnowy: {
+    id: "IndoorSnowy",
+    label: "Snowy Indoor",
+    origin: "FE6",
+    previewPng: "NewTilesets/IndoorSnowy.png",
+    configFile: "NewTilesets/SnowyTilesetIndoorTileConfiguration.mapchip_config",
+    objectSetSymbol: "IndoorSnowyObjectSet",
+    paletteSymbol: "IndoorSnowyPalette",
+    tileConfigSymbol: "IndoorSnowyTileConfig",
+    animsSymbol: null,
+    terrainConfigKey: "IndoorSnowy",
+  },
+  WesternIsles: {
+    id: "WesternIsles",
+    label: "Western Isles (extended)",
+    origin: "FE7",
+    previewPng: "NewTilesets/WesternIslesExtended-Tileset.png",
+    configFile: "NewTilesets/WesternIsles-Extended-Config.mapchip_config",
+    objectSetSymbol: "WesternIslesObjectSet",
+    paletteSymbol: "WesternIslesPalette",
+    tileConfigSymbol: "WesternIslesTileConfig",
+    animsSymbol: null,
+    terrainConfigKey: "WesternIsles",
+  },
+  ImprovedCastle: {
+    id: "ImprovedCastle",
+    label: "Improved Castle (animated)",
+    origin: "FE8",
+    previewPng: "NewTilesets/ImprovedCastle.png",
+    configFile: "NewTilesets/ImprovedCastle.mapchip_config",
+    objectSetSymbol: "ImprovedCastleObjectSet",
+    paletteSymbol: "ImprovedCastlePalette",
+    tileConfigSymbol: "ImprovedCastleTileConfig",
+    animsSymbol: "ImprovedCastleAnims",
+    terrainConfigKey: "ImprovedCastle",
+  },
+};
+
+/** One-line summary of every ported tileset, for import diagnostics. */
+export function describePortedTilesets(): string {
+  return Object.values(PORTED_TILESETS)
+    .map((t) => `${t.id} (${t.origin} -- ${t.label})`)
+    .join(", ");
+}
+
+/** Splits a CamelCase id into its lowercase words: OutdoorSnowy ->
+ * ["outdoor", "snowy"]. */
+function idWords(id: string): string[] {
+  return (id.match(/[A-Z]+(?![a-z])|[A-Z]?[a-z0-9]+/g) ?? [id]).map((w) =>
+    w.toLowerCase()
+  );
+}
+
+/**
+ * Resolves a raw .tmx tileset name to a ported tileset, if it names one.
+ *
+ * Matched loosely, because map packs label tilesets descriptively rather
+ * than with the exact id. A plain substring test wasn't loose enough:
+ * this function's own documented example, "FE6 Snowy Outdoor" finding
+ * OutdoorSnowy, did NOT work, because once punctuation is stripped
+ * "fe6snowyoutdoor" does not contain "outdoorsnowy" -- the words are in
+ * the other order. So a name has to contain every WORD of the id, in any
+ * order, which accepts "FE6 Snowy Outdoor", "Outdoor Snowy" and
+ * "OutdoorSnowy" alike.
+ *
+ * Requiring ALL the words is what keeps this from over-matching: a stock
+ * FE8 map labelled "FE8 - Castle" does not match ImprovedCastle, because
+ * "improved" is absent.
+ */
+export function findPortedTileset(
+  rawTilesetName: string
+): PortedTileset | null {
+  const normalized = rawTilesetName.replace(/[^a-z0-9]/gi, "").toLowerCase();
+  if (!normalized) return null;
+
+  let best: PortedTileset | null = null;
+  let bestScore = 0;
+  let tied = false;
+
+  for (const tileset of Object.values(PORTED_TILESETS)) {
+    const words = idWords(tileset.id);
+    if (!words.every((w) => normalized.includes(w))) continue;
+
+    // Longer total match wins, so an id that is a superset of another's
+    // words can't be beaten by the shorter one.
+    const score = words.join("").length;
+    if (score > bestScore) {
+      best = tileset;
+      bestScore = score;
+      tied = false;
+    } else if (score === bestScore) {
+      tied = true;
+    }
+  }
+
+  // An ambiguous name is not a match -- better to reject the map with a
+  // clear "rename the tileset" message than to silently pick one.
+  return tied ? null : best;
+}
