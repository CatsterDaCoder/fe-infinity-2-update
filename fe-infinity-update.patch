+ </tileset>
+ <layer id="1" name="Tile Layer 1" width="2" height="2">
+  <data encoding="csv">1,2,3,4</data>
+ </layer>
+ <layer id="2" name="Wall" width="2" height="2" visible="0">
+  <properties>
+   <property name="ID" value="0"/>
+   <property name="X" value="3"/>
+  </properties>
+  <data encoding="csv">0,0,0,0</data>
+ </layer>
+</map>
+`;
+
+Deno.test("prepareTmx - FEMapCreator export gets its ROM properties", () => {
+  const actual = prepareTmx({
+    tmx: MODERN_TMX,
+    mapName: "TribalMountain",
+    tileset: "3C00CE3E",
+  });
+
+  for (const prop of [
+    '<property name="Main" value=""/>',
+    '<property name="Anims" value="_3CAnims"/>',
+    '<property name="ChapterID" value="<CHAPTERID>"/>',
+    '<property name="MapChangesID" value="TribalMountain_Changes"/>',
+    '<property name="MapID" value="TribalMountain_Map"/>',
+    '<property name="ObjectType" value="0x3C"/>',
+    '<property name="PaletteID" value="0xCE"/>',
+    '<property name="TileConfig" value="0x3E"/>',
