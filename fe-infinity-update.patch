index 00000000..72a8663d
--- /dev/null
+++ b/server/webui/prompts/prompt-store.ts
@@ -0,0 +1,105 @@
+// Reads/writes user overrides for the prompts defined in registry.ts, and
+// renders the final prompt string (default or overridden) at call time.
+//
+// Overrides live in `server/webui/prompts/prompt-overrides.json`, a flat
+// `{ [promptId]: "custom template text" }` map. This file is gitignored by
+// default (see .gitignore entry added alongside this) so personal prompt
+// tweaks don't get committed accidentally -- copy it out if you want to
+// share/version a specific prompt set.
+
+import { ALL_PROMPTS, findPrompt } from "./registry.ts";
+
+const OVERRIDES_PATH = new URL("./prompt-overrides.json", import.meta.url);
+
+export interface PromptWithOverride {
+  id: string;
+  label: string;
+  description: string;
+  group: string;
+  sourceFile: string;
+  default: string;
+  current: string;
+  isOverridden: boolean;
+}
+
+async function readOverrides(): Promise<Record<string, string>> {
+  try {
+    const text = await Deno.readTextFile(OVERRIDES_PATH);
+    const parsed = JSON.parse(text);
+    if (parsed && typeof parsed === "object") return parsed;
+    return {};
+  } catch (err) {
+    if (err instanceof Deno.errors.NotFound) return {};
+    console.error("Failed to read prompt overrides, using defaults:", err);
+    return {};
+  }
+}
+
+async function writeOverrides(overrides: Record<string, string>): Promise<void> {
+  await Deno.writeTextFile(
+    OVERRIDES_PATH,
+    JSON.stringify(overrides, null, 2) + "\n"
+  );
+}
+
+/** Very small {{variable}} substitution -- intentionally not a full
+ * templating engine, since only a couple of prompts need interpolation. */
+export function renderTemplate(
+  template: string,
+  vars: Record<string, string | number> = {}
+): string {
+  return template.replace(/\{\{\s*(\w+)\s*\}\}/g, (_match, key: string) => {
+    return key in vars ? String(vars[key]) : `{{${key}}}`;
+  });
+}
+
+/** Resolves a prompt by id (override if present, else the registry
+ * default) and renders any {{placeholders}} with the given vars. This is
+ * what every ai/*.ts generation file calls instead of hardcoding its
+ * system prompt inline. */
+export async function getPrompt(
+  id: string,
+  vars: Record<string, string | number> = {}
+): Promise<string> {
+  const def = findPrompt(id);
+  if (!def) {
+    throw new Error(
+      `Unknown prompt id "${id}". Did you forget to add it to registry.ts?`
+    );
+  }
+  const overrides = await readOverrides();
+  const template = overrides[id] ?? def.template;
+  return renderTemplate(template, vars);
+}
+
+/** For the Web UI: every prompt, with its default + any current override. */
+export async function listPromptsWithOverrides(): Promise<PromptWithOverride[]> {
+  const overrides = await readOverrides();
+  return ALL_PROMPTS.map((p) => ({
+    id: p.id,
+    label: p.label,
+    description: p.description,
+    group: p.group,
+    sourceFile: p.sourceFile,
+    default: p.template,
+    current: overrides[p.id] ?? p.template,
+    isOverridden: p.id in overrides,
+  }));
+}
+
+export async function setPromptOverride(id: string, value: string): Promise<void> {
+  if (!findPrompt(id)) {
+    throw new Error(`Unknown prompt id "${id}"`);
+  }
+  const overrides = await readOverrides();
+  overrides[id] = value;
+  await writeOverrides(overrides);
+}
+
+export async function resetPromptOverride(id: string): Promise<void> {
+  const overrides = await readOverrides();
+  if (id in overrides) {
+    delete overrides[id];
+    await writeOverrides(overrides);
+  }
+}
