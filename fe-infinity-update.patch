new file mode 100644
index 00000000..e50e9344
--- /dev/null
+++ b/server/webui/server.ts
@@ -0,0 +1,456 @@
+// Deno HTTP server backing the fe-infinity Web UI.
+//
+// Run with: deno task webui   (see deno.json)
+//
+// Responsibilities:
+//   - Serve the static single-page frontend (public/).
+//   - Setup wizard: check/save the OpenAI API key into server/.env.
+//   - Prompt editor: list/edit/reset the prompts defined in webui/prompts.
+//   - Generation runner: spawn `main.ts` as a subprocess per run (so a
+//     crash in one generation can't take down the web server, and so we
+//     get real, ordered console output for free) and stream its stdout/
+//     stderr to the browser over Server-Sent Events.
+//
+// This intentionally has zero frontend build step -- just static files --
+// to match the rest of the project's "no bundler" Deno setup.
+
+import "jsr:@std/dotenv/load";
+import {
+  listPromptsWithOverrides,
+  setPromptOverride,
+  resetPromptOverride,
+} from "./prompts/prompt-store.ts";
+
+const PORT = Number(Deno.env.get("WEBUI_PORT") ?? 8787);
+const PUBLIC_DIR = new URL("./public/", import.meta.url);
+const ENV_PATH = new URL("../.env", import.meta.url); // server/.env
+const SERVER_DIR = new URL("../", import.meta.url); // server/ (cwd for spawning main.ts)
+
+// ---------------------------------------------------------------------------
+// Run management
+// ---------------------------------------------------------------------------
+
+type RunStatus = "running" | "success" | "failed" | "cancelled";
+
+interface Run {
+  id: string;
+  status: RunStatus;
+  worldIdea: string;
+  numberOfChapters: number;
+  skipRomBuild: boolean;
+  startedAt: number;
+  finishedAt?: number;
+  exitCode?: number;
+  lines: string[]; // full history, so late-connecting clients can replay
+  process?: Deno.ChildProcess;
+  listeners: Set<ReadableStreamDefaultController<Uint8Array>>;
+}
+
+const runs = new Map<string, Run>();
+
+function broadcast(run: Run, event: string, data: unknown) {
+  const payload = `event: ${event}\ndata: ${JSON.stringify(data)}\n\n`;
+  const bytes = new TextEncoder().encode(payload);
+  for (const controller of run.listeners) {
+    try {
+      controller.enqueue(bytes);
+    } catch {
+      // Client already gone; it'll be cleaned up when its stream cancels.
+    }
+  }
+}
+
+function appendLine(run: Run, line: string) {
+  run.lines.push(line);
+  broadcast(run, "line", { line });
+}
+
+async function startRun(opts: {
+  worldIdea: string;
+  numberOfChapters: number;
+  skipRomBuild: boolean;
+}): Promise<Run> {
+  const id = crypto.randomUUID();
+  const run: Run = {
+    id,
+    status: "running",
+    worldIdea: opts.worldIdea,
+    numberOfChapters: opts.numberOfChapters,
+    skipRomBuild: opts.skipRomBuild,
+    startedAt: Date.now(),
+    lines: [],
+    listeners: new Set(),
+  };
+  runs.set(id, run);
+
+  const args = [
+    "run",
+    "--allow-all",
+    "main.ts",
+    "--world-idea",
+    opts.worldIdea,
+    "--chapters",
+    String(opts.numberOfChapters),
+  ];
+  if (opts.skipRomBuild) args.push("--skip-rom-build");
+
+  let command: Deno.Command;
+  try {
+    command = new Deno.Command(Deno.execPath(), {
+      args,
+      cwd: SERVER_DIR,
+      stdout: "piped",
+      stderr: "piped",
+    });
+  } catch (err) {
+    run.status = "failed";
+    appendLine(run, `❌ Failed to launch generation process: ${err}`);
+    return run;
+  }
+
+  const child = command.spawn();
+  run.process = child;
+
+  pipeToLines(child.stdout, (line) => appendLine(run, line));
+  pipeToLines(child.stderr, (line) => appendLine(run, line));
+
+  child.status
+    .then((status) => {
+      run.finishedAt = Date.now();
+      run.exitCode = status.code;
+      run.status =
+        run.status === "cancelled"
+          ? "cancelled"
+          : status.success
+          ? "success"
+          : "failed";
+      broadcast(run, "done", {
+        status: run.status,
+        exitCode: status.code,
+      });
+      for (const controller of run.listeners) {
+        try {
+          controller.close();
+        } catch {
+          // already closed
+        }
+      }
+    })
+    .catch((err) => {
+      run.status = "failed";
+      appendLine(run, `❌ Process error: ${err}`);
+      broadcast(run, "done", { status: run.status });
+    });
+
+  return run;
+}
+
+async function pipeToLines(
+  stream: ReadableStream<Uint8Array>,
+  onLine: (line: string) => void
+) {
+  const reader = stream.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+  try {
+    while (true) {
+      const { value, done } = await reader.read();
+      if (done) break;
+      buffer += decoder.decode(value, { stream: true });
+      const parts = buffer.split("\n");
+      buffer = parts.pop() ?? "";
+      for (const part of parts) onLine(part);
+    }
+    if (buffer.length > 0) onLine(buffer);
+  } catch (err) {
+    onLine(`[stream error: ${err}]`);
+  }
+}
+
+function cancelRun(run: Run): boolean {
+  if (run.status !== "running" || !run.process) return false;
+  try {
+    run.process.kill("SIGTERM");
+    run.status = "cancelled";
+    appendLine(run, "🛑 Generation cancelled by user.");
+    return true;
+  } catch (err) {
+    appendLine(run, `Failed to cancel: ${err}`);
+    return false;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Setup (.env / API key)
+// ---------------------------------------------------------------------------
+
+async function readEnvFile(): Promise<Record<string, string>> {
+  try {
+    const text = await Deno.readTextFile(ENV_PATH);
+    const result: Record<string, string> = {};
+    for (const rawLine of text.split("\n")) {
+      const line = rawLine.trim();
+      if (!line || line.startsWith("#")) continue;
+      const eq = line.indexOf("=");
+      if (eq === -1) continue;
+      result[line.slice(0, eq).trim()] = line.slice(eq + 1).trim();
+    }
+    return result;
+  } catch (err) {
+    if (err instanceof Deno.errors.NotFound) return {};
+    throw err;
+  }
+}
+
+/**
+ * Ollama's OpenAI-compatible API lives under /v1, but it's an easy detail
+ * to miss when typing the address -- and "http://localhost:11434" without
+ * it produces a 404 on every single request rather than an obvious
+ * configuration error. Normalize it rather than making that the user's
+ * problem.
+ */
+function normalizeOllamaBaseUrl(raw: string): string {
+  let url = raw.trim().replace(/\/+$/, "");
+  if (!url) return "";
+  if (!/^https?:\/\//i.test(url)) url = `http://${url}`;
+  if (!/\/v\d+$/.test(url)) url = `${url}/v1`;
+  return url;
+}
+
+async function writeEnvFile(values: Record<string, string>): Promise<void> {
+  const existing = await readEnvFile();
+  const merged = { ...existing, ...values };
+  const text =
+    Object.entries(merged)
+      .map(([k, v]) => `${k}=${v}`)
+      .join("\n") + "\n";
+  await Deno.writeTextFile(ENV_PATH, text);
+}
+
+// ---------------------------------------------------------------------------
+// HTTP handling
+// ---------------------------------------------------------------------------
+
+const MIME_TYPES: Record<string, string> = {
+  ".html": "text/html; charset=utf-8",
+  ".js": "text/javascript; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".json": "application/json; charset=utf-8",
+  ".svg": "image/svg+xml",
+};
+
+function json(data: unknown, init: ResponseInit = {}): Response {
+  return new Response(JSON.stringify(data), {
+    ...init,
+    headers: {
+      "content-type": "application/json; charset=utf-8",
+      ...(init.headers ?? {}),
+    },
+  });
+}
+
+async function serveStatic(pathname: string): Promise<Response> {
+  const relative = pathname === "/" ? "index.html" : pathname.slice(1);
+  // Prevent path traversal outside PUBLIC_DIR.
+  if (relative.includes("..")) return new Response("Not found", { status: 404 });
+  const fileUrl = new URL(relative, PUBLIC_DIR);
+  try {
+    const data = await Deno.readFile(fileUrl);
+    const ext = relative.slice(relative.lastIndexOf("."));
+    return new Response(data, {
+      headers: { "content-type": MIME_TYPES[ext] ?? "application/octet-stream" },
+    });
+  } catch {
+    return new Response("Not found", { status: 404 });
+  }
+}
+
+async function handler(req: Request): Promise<Response> {
+  const url = new URL(req.url);
+  const { pathname } = url;
+
+  try {
+    // --- Setup -------------------------------------------------------
+    if (pathname === "/api/setup" && req.method === "GET") {
+      const env = await readEnvFile();
+      const provider = (env["AI_PROVIDER"] || "openai").toLowerCase();
+      return json({
+        provider,
+        hasApiKey: Boolean(env["OPENAI_API_KEY"]),
+        model:
+          (provider === "ollama" ? env["OLLAMA_MODEL"] : env["OPENAI_MODEL"]) ||
+          "",
+        ollamaBaseUrl: env["OLLAMA_BASE_URL"] || "",
+      });
+    }
+    if (pathname === "/api/setup" && req.method === "POST") {
+      const body = await req.json();
+      const updates: Record<string, string> = {};
+
+      // Both fields are optional so the model can be changed without
+      // re-entering the API key, and vice versa.
+      if (body.apiKey !== undefined) {
+        const apiKey = String(body.apiKey).trim();
+        if (!apiKey) {
+          return json({ error: "apiKey must not be empty" }, { status: 400 });
+        }
+        updates["OPENAI_API_KEY"] = apiKey;
+      }
+      if (body.provider !== undefined) {
+        const provider = String(body.provider).trim().toLowerCase();
+        if (provider !== "openai" && provider !== "ollama") {
+          return json(
+            { error: "provider must be 'openai' or 'ollama'" },
+            { status: 400 }
+          );
+        }
+        updates["AI_PROVIDER"] = provider;
+      }
+      if (body.model !== undefined) {
+        // Which key the model name belongs under depends on the provider
+        // being configured, so resolve it from the request or the
+        // already-saved value.
+        const env = await readEnvFile();
+        const provider = String(
+          body.provider ?? env["AI_PROVIDER"] ?? "openai"
+        )
+          .trim()
+          .toLowerCase();
+        updates[provider === "ollama" ? "OLLAMA_MODEL" : "OPENAI_MODEL"] =
+          String(body.model).trim();
+      }
+      if (body.ollamaBaseUrl !== undefined) {
+        updates["OLLAMA_BASE_URL"] = normalizeOllamaBaseUrl(
+          String(body.ollamaBaseUrl)
+        );
+      }
+
+      if (Object.keys(updates).length === 0) {
+        return json(
+          { error: "Nothing to update: provide apiKey and/or model" },
+          { status: 400 }
+        );
+      }
+      await writeEnvFile(updates);
+      return json({ ok: true });
+    }
+
+    // --- Prompts -------------------------------------------------------
+    if (pathname === "/api/prompts" && req.method === "GET") {
+      return json(await listPromptsWithOverrides());
+    }
+    const promptMatch = pathname.match(/^\/api\/prompts\/([\w-]+)(\/reset)?$/);
+    if (promptMatch && req.method === "POST") {
+      const [, id, resetSuffix] = promptMatch;
+      if (resetSuffix) {
+        await resetPromptOverride(id);
+        return json({ ok: true });
+      }
+      const body = await req.json();
+      const value = String(body.value ?? "");
+      await setPromptOverride(id, value);
+      return json({ ok: true });
+    }
+
+    // --- Generation runner ----------------------------------------------
+    if (pathname === "/api/generate" && req.method === "POST") {
+      const body = await req.json();
+      const worldIdea = String(body.worldIdea ?? "").trim();
+      if (!worldIdea) {
+        return json({ error: "worldIdea is required" }, { status: 400 });
+      }
+      const numberOfChapters = Math.max(
+        1,
+        Math.min(10, Number(body.numberOfChapters) || 3)
+      );
+      const skipRomBuild = Boolean(body.skipRomBuild);
+      const run = await startRun({ worldIdea, numberOfChapters, skipRomBuild });
+      return json({ runId: run.id });
+    }
+
+    const runMatch = pathname.match(/^\/api\/generate\/([\w-]+)$/);
+    if (runMatch && req.method === "GET") {
+      const run = runs.get(runMatch[1]);
+      if (!run) return json({ error: "Run not found" }, { status: 404 });
+      return json({
+        id: run.id,
+        status: run.status,
+        worldIdea: run.worldIdea,
+        numberOfChapters: run.numberOfChapters,
+        startedAt: run.startedAt,
+        finishedAt: run.finishedAt,
+        exitCode: run.exitCode,
+      });
+    }
+
+    const cancelMatch = pathname.match(/^\/api\/generate\/([\w-]+)\/cancel$/);
+    if (cancelMatch && req.method === "POST") {
+      const run = runs.get(cancelMatch[1]);
+      if (!run) return json({ error: "Run not found" }, { status: 404 });
+      const cancelled = cancelRun(run);
+      return json({ cancelled });
+    }
+
+    const eventsMatch = pathname.match(/^\/api\/generate\/([\w-]+)\/events$/);
+    if (eventsMatch && req.method === "GET") {
+      const run = runs.get(eventsMatch[1]);
+      if (!run) return json({ error: "Run not found" }, { status: 404 });
+
+      const stream = new ReadableStream<Uint8Array>({
+        start(controller) {
+          // Replay history so a client that connects mid-run (or
+          // reconnects) doesn't miss anything.
+          for (const line of run.lines) {
+            controller.enqueue(
+              new TextEncoder().encode(
+                `event: line\ndata: ${JSON.stringify({ line })}\n\n`
+              )
+            );
+          }
+          if (run.status !== "running") {
+            controller.enqueue(
+              new TextEncoder().encode(
+                `event: done\ndata: ${JSON.stringify({
+                  status: run.status,
+                  exitCode: run.exitCode,
+                })}\n\n`
+              )
+            );
+            controller.close();
+            return;
+          }
+          run.listeners.add(controller);
+        },
+        cancel() {
+          for (const controller of run.listeners) {
