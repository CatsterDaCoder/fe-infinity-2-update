 import "jsr:@std/dotenv/load";
 import { ZodSchema } from "zod";
 
+const DEFAULT_MAX_ATTEMPTS = 3;
+
+
+/**
+ * Every AI-generated piece of the game (world, characters, maps, dialogue,
+ * unit placement, ...) flows through this one function. That makes it the
