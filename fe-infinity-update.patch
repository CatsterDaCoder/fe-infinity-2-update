@@ -20,8 +20,20 @@ smallwm_tsa_dmp="$script_dir/SmallWMTSA.dmp"
 png2dmp="$tools_dir/Png2Dmp"
 compress="$tools_dir/compress"
 
+# Many systems (Ubuntu/Debian, including WSL) only install `python3` and
+# deliberately don't alias it to `python`, so a bare `python` call used to
+# fail here with "command not found" even though Python 3 was right there.
+if command -v python3 &>/dev/null; then
+  python_cmd="python3"
+elif command -v python &>/dev/null; then
+  python_cmd="python"
+else
+  echo "Python 3 is required but wasn't found on PATH. Please install Python 3 and try again." >&2
+  exit 1
+fi
+
 # Run the assembler using Python with absolute paths for tools
