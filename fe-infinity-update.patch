diff --git a/romBuilder/run-windows-exe.sh b/romBuilder/run-windows-exe.sh
new file mode 100755
index 00000000..4aa35177
--- /dev/null
+++ b/romBuilder/run-windows-exe.sh
@@ -0,0 +1,96 @@
+#!/bin/bash
+# Runs a Windows .exe tool (e.g. tmx2ea.exe, compress.exe).
+#
+# These build scripts were written assuming a Mac/Linux dev machine, where
+# running a Windows .exe requires Wine as a compatibility layer. On WSL,
+# that's often unnecessary -- WSL can frequently execute a .exe directly
+# and have it run as a genuine Windows process, via a kernel-level
+# interop feature. But that feature isn't guaranteed to be enabled or
+# applicable on every WSL setup, and when it isn't, what actually happens
+# varies by system: some environments fail with a plain "Exec format
+# error" from the shell itself; others have Debian's binfmt-support
+# registered as a catch-all, which instead runs its own `run-detectors`
+# program (successfully, as far as the kernel/shell are concerned) and
+# THAT then fails with "run-detectors: unable to find an interpreter for
+# ./foo.exe" -- a normal, but non-standardized, exit code from a program
+# that ran, not a shell-level exec failure. Different environments can
+# even use different exit codes for the same underlying problem.
+#
+# Because there's no single reliable exit code for "direct execution
+# didn't work" across environments, this checks the actual output text
+# for the known failure signatures instead: try direct execution first
+# (fast, and the common case on WSL), and if it fails with output
+# matching one of those signatures, fall back to Wine automatically. On
+# genuine Linux/macOS (no Windows kernel underneath at all), skip
+# straight to Wine.
+set -e
+
+is_running_on_real_windows_kernel() {
+  # WSL: /proc/version mentions "microsoft" (case differs between WSL1
+  # and WSL2, hence -i).
+  if grep -qi microsoft /proc/version 2>/dev/null; then
+    return 0
+  fi
+  # Git Bash / MSYS / Cygwin on native Windows report one of these via
+  # `uname -s`.
+  case "$(uname -s 2>/dev/null)" in
+    MINGW* | MSYS* | CYGWIN*) return 0 ;;
+  esac
+  return 1
+}
+
+# Known signatures of "the OS couldn't actually execute this binary",
+# across the different ways that shows up on different systems.
+looks_like_exec_failure() {
+  printf '%s' "$1" | grep -qiE \
+    "run-detectors: unable to find an interpreter|cannot execute binary file|exec format error|no such file or directory.*\\.exe|permission denied"
+}
+
+run_with_wine() {
+  if ! command -v wine >/dev/null 2>&1; then
+    echo "Error: this step needs to run a Windows tool (${1:-<unknown>}), and 'wine' isn't installed." >&2
+    echo "  - On Linux (including WSL, if direct .exe execution isn't working here):" >&2
+    echo "      sudo apt install wine" >&2
+    echo "    Some of these tools (e.g. tmx2ea.exe) are 32-bit, and a plain 'wine' install on a" >&2
+    echo "    64-bit system (the default on Ubuntu 24.04+) can't run them without also installing:" >&2
+    echo "      sudo dpkg --add-architecture i386 && sudo apt-get update && sudo apt-get install wine32:i386" >&2
+    echo "    If wine already created ~/.wine before wine32 was installed, delete it (rm -rf ~/.wine)" >&2
+    echo "    afterward so it gets recreated with 32-bit support." >&2
+    echo "  - On macOS: 'brew install --cask wine-stable' (or similar)." >&2
+    exit 1
+  fi
+  # WINEDLLOVERRIDES disables Wine's Gecko/Mono auto-install prompt --
+  # without this, Wine's very first run ever can pop up a GUI dialog that
+  # a non-interactive script has no way to click through, which just
+  # looks like the whole build hanging forever.
+  WINEDLLOVERRIDES="mscoree,mshtml=" wine "$@"
+}
+
+if is_running_on_real_windows_kernel; then
+  attempt_output_file="$(mktemp)"
+  set +e
+  "$@" 2>"$attempt_output_file"
+  status=$?
+  set -e
+  attempt_output="$(cat "$attempt_output_file")"
+  rm -f "$attempt_output_file"
+
+  if [ "$status" -eq 0 ]; then
+    exit 0
+  fi
+
+  if looks_like_exec_failure "$attempt_output"; then
+    echo "Note: couldn't execute ${1:-<unknown>} directly here ($attempt_output) -- falling back to Wine." >&2
+    run_with_wine "$@"
+  else
+    # A real failure from the tool itself (bad arguments, etc.) rather
+    # than an inability to execute it at all -- show what it said and
+    # preserve its exit code instead of masking it with a Wine retry.
+    if [ -n "$attempt_output" ]; then
+      echo "$attempt_output" >&2
+    fi
+    exit "$status"
+  fi
+else
+  run_with_wine "$@"
+fi
