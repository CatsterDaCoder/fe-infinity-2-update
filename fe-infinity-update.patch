diff --git a/server/ai/assemble-chapter-event/unit-placement/to-rom-class-name.ts b/server/ai/assemble-chapter-event/unit-placement/to-rom-class-name.ts
new file mode 100644
index 00000000..1ca4c12c
--- /dev/null
+++ b/server/ai/assemble-chapter-event/unit-placement/to-rom-class-name.ts
@@ -0,0 +1,53 @@
+/**
+ * Translates a class name as the AI and the rest of the pipeline speak it
+ * ("Journeyman") into the symbol the ROM actually defines
+ * ("Journeyman_1").
+ *
+ * FE8's three trainee lines are the only classes where those differ.
+ * "FE8 Definitions.txt" defines them ONLY in tiered form:
+ *
+ *   Journeyman_1 0x3D   Journeyman_2 0x7E   Journeyman_3 0x38
+ *   Pupil_1      0x3E   Pupil_2      0x7F   Pupil_3      0x39
+ *   Recruit_1    0x47   Recruit_2    0x37   Recruit_3    0x3A
+ *
+ * There is no bare `Journeyman`, `Pupil` or `Recruit` symbol anywhere in
+ * the ROM, so a UNIT line naming one failed assembly with "Undefined
+ * identifier: Journeyman". That made the trainee classes look
+ * unavailable when in fact they only needed their tier.
+ *
+ * Everywhere else -- prompts, CLASS_WEAPON_TYPES, GENERIC_ENEMY_CLASSES,
+ * class-options.ts -- keeps using the plain name, because that's the name
+ * a person (and a language model) would use. Only the emitted ROM symbol
+ * is tiered, and only here.
+ */
+
+/** Plain trainee name -> the unpromoted (tier 1) ROM symbol. */
+const TRAINEE_ROM_NAMES: Record<string, string> = {
+  Journeyman: "Journeyman_1",
+  Pupil: "Pupil_1",
+  Recruit: "Recruit_1",
+};
+
+/** True if the name already carries a trainee tier suffix. */
+function hasTierSuffix(className: string): boolean {
+  return /_(1|2|3)$/.test(className);
+}
+
+/**
+ * Returns the ROM symbol for a class name. Idempotent: a name that is
+ * already tiered (as class-name-to-rom-class-name.ts produces for named
+ * characters) is returned unchanged, so it's safe to apply at any point
+ * in the chain.
+ */
+export default function toRomClassName(className: string): string {
+  if (hasTierSuffix(className)) return className;
+  return TRAINEE_ROM_NAMES[className] ?? className;
+}
+
+/**
+ * The inverse: strips a trainee tier so the name can be looked up in
+ * tables keyed by the plain name (CLASS_WEAPON_TYPES, class-options).
+ */
+export function stripTierSuffix(className: string): string {
+  return className.replace(/_(1|2|3)$/, "");
+}
diff --git a/server/ai/assemble-chapter-event/unit-placement/to-rom-class-name_test.ts b/server/ai/assemble-chapter-event/unit-placement/to-rom-class-name_test.ts
new file mode 100644
index 00000000..7ce61939
--- /dev/null
+++ b/server/ai/assemble-chapter-event/unit-placement/to-rom-class-name_test.ts
@@ -0,0 +1,75 @@
+import toRomClassName, {
+  stripTierSuffix,
+} from "@/ai/assemble-chapter-event/unit-placement/to-rom-class-name.ts";
+import { getWeaponTypesForClass } from "@/ai/assemble-chapter-event/unit-placement/getWeaponTypesForClass.ts";
+import classNameToRomClassName from "@/ai/assemble-rom-character/assemble-character-csv-data/class-name-to-rom-class-name.ts";
+import { GENERIC_ENEMY_CLASSES } from "@/ai/assemble-chapter-event/unit-placement/generic-enemy-classes.ts";
+import { assertEquals } from "@std/assert";
+
+Deno.test("toRomClassName tiers FE8's trainees", () => {
+  // The ROM defines Journeyman_1/_2/_3 and no bare "Journeyman", so an
+  // untiered name failed assembly with "Undefined identifier:
+  // Journeyman".
+  assertEquals(toRomClassName("Journeyman"), "Journeyman_1");
+  assertEquals(toRomClassName("Pupil"), "Pupil_1");
+  assertEquals(toRomClassName("Recruit"), "Recruit_1");
+});
+
+Deno.test("toRomClassName leaves every other class alone", () => {
+  for (const c of ["Mage", "Cavalier", "Soldier", "Knight", "Mage_F", "SoldierF2"]) {
+    assertEquals(toRomClassName(c), c);
+  }
+});
+
+Deno.test("toRomClassName is idempotent", () => {
+  // It runs in generate-unit-line, downstream of
+  // class-name-to-rom-class-name, which already emits the tiered form
+  // for named characters -- so applying it twice must be a no-op.
+  for (const c of ["Journeyman_1", "Pupil_2", "Recruit_3"]) {
+    assertEquals(toRomClassName(c), c);
+  }
+  assertEquals(toRomClassName(toRomClassName("Journeyman")), "Journeyman_1");
+});
+
+Deno.test("named trainee characters get the tiered ROM symbol", () => {
+  assertEquals(
+    classNameToRomClassName({ className: "Journeyman", characterGender: "male" }),
+    "Journeyman_1"
+  );
+  assertEquals(
+    classNameToRomClassName({ className: "Pupil", characterGender: "male" }),
+    "Pupil_1"
+  );
+  assertEquals(
+    classNameToRomClassName({ className: "Recruit", characterGender: "female" }),
+    "Recruit_1"
+  );
+});
+
+Deno.test("trainees get their real weapons, not the Sword fallback", () => {
+  // getWeaponTypesForClass is keyed by the plain name, so it has to see
+  // through the tier suffix -- otherwise every trainee fell through to
+  // the fallback and was handed a sword it can't use.
+  assertEquals(getWeaponTypesForClass("Journeyman"), ["Axe"]);
+  assertEquals(getWeaponTypesForClass("Journeyman_1"), ["Axe"]);
+  assertEquals(getWeaponTypesForClass("Pupil"), ["Anima"]);
+  assertEquals(getWeaponTypesForClass("Pupil_1"), ["Anima"]);
+  assertEquals(getWeaponTypesForClass("Recruit"), ["Lance"]);
+  assertEquals(getWeaponTypesForClass("Recruit_1"), ["Lance"]);
+});
+
+Deno.test("stripTierSuffix only strips trainee tiers", () => {
+  assertEquals(stripTierSuffix("Journeyman_1"), "Journeyman");
+  assertEquals(stripTierSuffix("Pupil_3"), "Pupil");
+  assertEquals(stripTierSuffix("Mage"), "Mage");
+  assertEquals(stripTierSuffix("Mage_F"), "Mage_F");
+});
+
+Deno.test("every generic enemy class has a non-empty weapon list", () => {
+  // An empty list makes generate-inventory an impossible request, which
+  // previously killed an entire run after its retries were exhausted.
+  for (const c of GENERIC_ENEMY_CLASSES) {
+    const types = getWeaponTypesForClass(toRomClassName(c));
+    assertEquals(types.length > 0, true, `${c} has no weapon types`);
+  }
+});
