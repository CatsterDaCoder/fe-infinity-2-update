 #!/bin/bash
+#
+# Compresses each ported tileset's mapchip config into the .dmp that
+# TilesetInstaller.event #incbin's.
+#
+# WHY THIS MATTERS: every one of these .dmp files was committed to the
+# repo as 0 BYTES. The original script was
+#
+#   wine compress.exe DesertTemple.mapchip_config >DesertTemple.mapchip_config.dmp
+#
+# and the `>` redirect creates and truncates the output file BEFORE the
+# command runs. So when wine wasn't installed -- or when the script was
+# never run at all, as its own comment admitted ("because they aren't
+# [changing] I'm not running it for now") -- what was left behind was an
+# empty file that looked like a successful build product. EventAssembler
+# then happily included nothing, and all five ported tilesets shipped
+# with an empty tile configuration.
+#
+# This version writes to a temporary file, checks the result is non-empty
+# and carries the GBA LZ77 header (0x10), and only then moves it into
+# place. A failure now leaves the previous .dmp untouched and exits
+# non-zero instead of silently emptying it.
 
-# This script should be run if any of these files change, but because they aren't I'm not running it for now.
+set -euo pipefail
 
-# Suppress fixme and other Wine debug messages
-export WINEDEBUG=-all
+cd "$(cd "$(dirname "$0")" && pwd)"
 
-wine compress.exe DesertTemple.mapchip_config >DesertTemple.mapchip_config.dmp
-wine compress.exe SnowyTilesetOutdoorTileConfiguration.mapchip_config >SnowyTilesetOutdoorTileConfiguration.mapchip_config.dmp
-wine compress.exe SnowyTilesetIndoorTileConfiguration.mapchip_config >SnowyTilesetIndoorTileConfiguration.mapchip_config.dmp
-wine compress.exe WesternIsles-Extended-Config.mapchip_config >WesternIsles-Extended-Config.mapchip_config.dmp
-wine compress.exe ImprovedCastle.mapchip_config >ImprovedCastle.mapchip_config.dmp
+# Prefer the bundled Python compressor: it's the same GBA LZ77 format,
+# runs anywhere, and needs neither wine nor a 32-bit loader. Fall back to
+# compress.exe for anyone who'd rather use the original tool.
+LINUX_COMPRESS="../../../LinuxTools/compress"
+RUN_EXE="../../../run-windows-exe.sh"
+
+compress_one() {
+  local src="$1"
+  local dst="$src.dmp"
+  local tmp
+  tmp="$(mktemp)"
+
+  if [ -x "$LINUX_COMPRESS" ] || command -v python3 >/dev/null 2>&1; then
+    python3 "$LINUX_COMPRESS" "$src" >"$tmp"
+  else
+    "$RUN_EXE" ./compress.exe "$src" >"$tmp"
+  fi
+
+  if [ ! -s "$tmp" ]; then
+    rm -f "$tmp"
+    echo "ERROR: compressing $src produced no output; leaving $dst alone." >&2
+    return 1
+  fi
+
+  # First byte of a GBA LZ77 stream is 0x10. Anything else means the
+  # tool wrote an error message into the file instead of binary data.
+  local magic
+  magic="$(head -c 1 "$tmp" | od -An -tx1 | tr -d ' \n')"
+  if [ "$magic" != "10" ]; then
+    rm -f "$tmp"
+    echo "ERROR: $src compressed to something that isn't GBA LZ77 (first byte 0x$magic); leaving $dst alone." >&2
+    return 1
+  fi
+
+  mv "$tmp" "$dst"
+  # mktemp creates 0600; these are checked-in build products, so give
+  # them the same permissions as everything else in here.
+  chmod 644 "$dst"
+  printf '  %-44s %7s -> %7s bytes\n' "$src" "$(wc -c <"$src")" "$(wc -c <"$dst")"
+}
+
+echo "Compressing ported tileset configs..."
+compress_one DesertTemple.mapchip_config
+compress_one SnowyTilesetOutdoorTileConfiguration.mapchip_config
+compress_one SnowyTilesetIndoorTileConfiguration.mapchip_config
+compress_one WesternIsles-Extended-Config.mapchip_config
+compress_one ImprovedCastle.mapchip_config
+echo "Done."
+echo
+echo "If any config changed, also re-run:  deno task import-ported-tileset-terrain"
+echo "so the terrain lookup matches the new data."
