diff --git a/romBuilder/AssembleText.sh b/romBuilder/AssembleText.sh
index 4a094a42..0973e3b6 100755
--- a/romBuilder/AssembleText.sh
+++ b/romBuilder/AssembleText.sh
@@ -1,11 +1,45 @@
 #!/bin/bash
 
+# Fail loudly instead of silently continuing. Without this, a failure in
+# the Python text-processing step below still printed "Assembling Text
+# Complete" and exited 0, so AssembleAll.sh saw success and carried on --
+# and the missing InstallTextData.event (which defines every text label in
+# the game) then produced hundreds of confusing "Undefined identifier:
+# <Something>Text" errors during the final ROM build, far away from the
+# step that actually failed.
+set -e
+
 # Navigate to the Text directory relative to the script's location
 script_dir="$(cd "$(dirname "$0")" && pwd)"
 cd "$script_dir/Text"
 
 echo "Assembling text..."
 
-python3 ./textprocess-classic-narrow.py "TextBuildfile.s" --parser-exe "./ParseFileMac" --installer InstallTextData.event --definitions TextDefinitions.event
+# ParseFileMac (checked in right here in Text/) is, as the name says, a
+# macOS-only binary -- calling it on Linux/WSL fails with "Exec format
+# error" for the same reason Png2Dmp/PortraitFormatter did (see
+# AssembleGraphics.sh and LinuxTools/ for the fuller explanation). Reuse
+# the Linux build of the same ParseFile tool from LinuxTools/ there.
+case "$(uname -s)" in
+Linux*)
+  parser_exe="$script_dir/LinuxTools/ParseFile"
+  ;;
+*)
+  parser_exe="./ParseFileMac"
+  ;;
+esac
+
+python3 ./textprocess-classic-narrow.py "TextBuildfile.s" --parser-exe "$parser_exe" --installer InstallTextData.event --definitions TextDefinitions.event
+
+# textprocess-classic-narrow.py can report individual per-entry errors and
+# still exit 0, so confirm it actually produced the installer file that
+# the rest of the build depends on.
+if [ ! -f "InstallTextData.event" ]; then
+  echo "Error: text processing did not produce Text/InstallTextData.event." >&2
+  echo "Every text label in the game is defined there, so continuing would produce" >&2
+  echo "hundreds of 'Undefined identifier: ...Text' errors later in the ROM build." >&2
+  echo "See the text-processing output above for the underlying cause." >&2
+  exit 1
+fi
 
 echo "Assembling Text Complete"
