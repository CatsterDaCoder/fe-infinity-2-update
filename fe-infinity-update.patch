+import findMainLayer, {
+  findAllLayers,
+  getTagAttribute,
+} from "@/map-processing/find-main-layer.ts";
+import getMainLayerTiles from "@/map-processing/get-info-from-tmx/get-main-layer-tiles.ts";
+import extractValuesFromTmx from "@/map-processing/get-info-from-tmx/extract-values-from-tmx.ts";
+import { assertEquals } from "@std/assert";
+
+const DATA = `<data encoding="csv">1,2,3,4</data>`;
+
+function map(layers: string, mapAttrs = 'width="2" height="2"') {
+  return `<?xml version="1.0" encoding="UTF-8"?>
+<map version="1.9" orientation="orthogonal" ${mapAttrs} tilewidth="16" tileheight="16">
+ <tileset firstgid="1" name="3C00CE3E" tilewidth="16" tileheight="16">
+  <image source="x.png" width="512" height="512"/>
+ </tileset>
+${layers}
+</map>`;
+}
+
+Deno.test("getTagAttribute reads attributes at any position", () => {
+  const tag = ` id="1" name="Tile Layer 1" width="20"`;
+  assertEquals(getTagAttribute(tag, "name"), "Tile Layer 1");
+  assertEquals(getTagAttribute(tag, "id"), "1");
+  assertEquals(getTagAttribute(tag, "width"), "20");
+  assertEquals(getTagAttribute(tag, "height"), null);
+});
+
+Deno.test("getTagAttribute does not confuse width with tilewidth", () => {
+  const tag = ` tilewidth="16" tileheight="16" width="20" height="18"`;
+  assertEquals(getTagAttribute(tag, "width"), "20");
+  assertEquals(getTagAttribute(tag, "height"), "18");
+});
+
+Deno.test("findMainLayer prefers 'Main'", () => {
+  const tmx = map(
+    ` <layer id="1" name="Tile Layer 1">${DATA}</layer>\n` +
+      ` <layer id="2" name="Main">${DATA}</layer>`
+  );
+  assertEquals(findMainLayer(tmx)?.name, "Main");
+});
+
+Deno.test("findMainLayer accepts Tiled's default 'Tile Layer 1'", () => {
+  // Tiled 1.2+ (and therefore FEMapCreator) writes id= before name=.
+  // The old regexes required name= to be the FIRST attribute, so this
+  // whole shape was invisible to them.
+  const tmx = map(` <layer id="1" name="Tile Layer 1">${DATA}</layer>`);
+  assertEquals(findMainLayer(tmx)?.name, "Tile Layer 1");
+});
+
+Deno.test("findMainLayer falls back to the first layer when unnamed", () => {
+  const tmx = map(` <layer id="1">${DATA}</layer>`);
+  assertEquals(findMainLayer(tmx)?.name, null);
+  assertEquals(findMainLayer(tmx)?.inner.includes("1,2,3,4"), true);
+});
+
+Deno.test("findMainLayer returns null when there are no layers", () => {
+  assertEquals(findMainLayer(map("")), null);
+});
+
+Deno.test("findAllLayers returns every layer in document order", () => {
+  const tmx = map(
+    ` <layer id="1" name="Main">${DATA}</layer>\n` +
+      ` <layer id="2" name="Wall">${DATA}</layer>\n` +
+      ` <layer id="3" name="Left Chest">${DATA}</layer>`
+  );
+  assertEquals(
+    findAllLayers(tmx).map((l) => l.name),
+    ["Main", "Wall", "Left Chest"]
+  );
+});
+
+Deno.test(
+  "terrain reader and value extractor resolve the SAME layer",
+  () => {
+    // They used to disagree, which is the whole reason this module
+    // exists: prepare-tmx wrote ROM properties to one layer while the
+    // terrain came from another (or from none at all).
+    const tmx = map(
+      ` <layer id="1" name="Tile Layer 1"><data encoding="csv">9,9,9,9</data></layer>\n` +
+        ` <layer id="2" name="Main">${DATA}</layer>`
+    );
+    assertEquals(getMainLayerTiles(tmx), [1, 2, 3, 4]);
+    assertEquals(findMainLayer(tmx)?.name, "Main");
+  }
+);
+
+Deno.test("extractValuesFromTmx reads a modern Tiled export", () => {
+  const tmx = map(` <layer id="1" name="Tile Layer 1">${DATA}</layer>`);
+  const { tileset, width, height } = extractValuesFromTmx(tmx);
+  assertEquals(tileset, "3C00CE3E");
+  // Previously this returned 512, the <image> width, because it took the
+  // first width=" anywhere in the file.
+  assertEquals(width, 2);
+  assertEquals(height, 2);
+});
+
+Deno.test("extractValuesFromTmx handles an external .tsx tileset", () => {
+  const tmx = `<?xml version="1.0" encoding="UTF-8"?>
+<map version="1.9" orientation="orthogonal" width="2" height="2" tilewidth="16" tileheight="16">
+ <tileset firstgid="1" source="tilesets/3C00CE3E.tsx"/>
+ <layer id="1" name="Tile Layer 1">${DATA}</layer>
+</map>`;
+  assertEquals(extractValuesFromTmx(tmx).tileset, "3C00CE3E");
+});
