diff --git a/server/map-processing/find-main-layer.ts b/server/map-processing/find-main-layer.ts
new file mode 100644
index 00000000..7f8dc88a
--- /dev/null
+++ b/server/map-processing/find-main-layer.ts
@@ -0,0 +1,86 @@
+/**
+ * Locates a .tmx file's main tile layer.
+ *
+ * This exists because three places used to answer "which layer is the
+ * main one?" with three different regexes, and they disagreed:
+ *
+ *   - get-main-layer-tiles.ts  accepted "Main", "Tile Layer 1", or the
+ *                              first layer, with `name` anywhere in the tag
+ *   - prepare-tmx.ts           accepted only `name="Main"`
+ *   - extract-values-from-tmx.ts  required `name` to be the FIRST
+ *                              attribute of <layer>
+ *
+ * Every disagreement is a silent wrong answer rather than an error.
+ * FEMapCreator (and any Tiled 1.9+) names the layer "Tile Layer 1" and
+ * writes `<layer id="1" name="...">`, so on a FEMapCreator export the
+ * terrain reader found the layer, prepare-tmx did NOT, and
+ * extract-values-from-tmx did not either. prepare-tmx therefore wrote no
+ * ROM properties at all, tmx2ea fell back to its documented literal
+ * defaults, and the build died on:
+ *
+ *   Undefined identifier: ChapterID
+ *   Undefined identifier: ObjectType
+ *   Undefined identifier: PaletteID
+ *   Undefined identifier: TileConfig
+ *   Undefined identifier: map_id
+ *
+ * Resolution order, applied consistently everywhere:
+ *   1. a layer named "Main"          (this project's own maps)
+ *   2. a layer named "Tile Layer 1"  (Tiled/FEMapCreator default)
+ *   3. the first layer               (a single-layer map is unambiguous)
+ */
+
+/** Reads an attribute out of an opening tag, at any position. */
+export function getTagAttribute(tag: string, name: string): string | null {
+  const match = new RegExp(`\\b${name}\\s*=\\s*"([^"]*)"`, "i").exec(tag);
+  return match ? match[1] : null;
+}
+
+export interface MainLayer {
+  /** Index of the layer's first character within the .tmx string. */
+  start: number;
+  /** Index one past the layer's last character. */
+  end: number;
+  /** The whole `<layer ...>...</layer>` element. */
+  body: string;
+  /** The layer's `name` attribute, or null if it has none. */
+  name: string | null;
+  /** Everything between `<layer ...>` and `</layer>`. */
+  inner: string;
+}
+
+const LAYER_PATTERN = /<layer\b([^>]*)>([\s\S]*?)<\/layer>/gi;
+
+/** Every `<layer>` element in the file, in document order. */
+export function findAllLayers(tmx: string): MainLayer[] {
+  const layers: MainLayer[] = [];
+  LAYER_PATTERN.lastIndex = 0;
+  let match: RegExpExecArray | null;
+  while ((match = LAYER_PATTERN.exec(tmx)) !== null) {
+    layers.push({
+      start: match.index,
+      end: match.index + match[0].length,
+      body: match[0],
+      name: getTagAttribute(match[1], "name"),
+      inner: match[2],
+    });
+  }
+  return layers;
+}
+
+/**
+ * Returns the main tile layer, or null if the file has no layers at all.
+ * Note this prefers "Main" over "Tile Layer 1" by NAME, not by document
+ * order -- a map carrying both should use the one that was deliberately
+ * named.
+ */
+export default function findMainLayer(tmx: string): MainLayer | null {
+  const layers = findAllLayers(tmx);
+  if (layers.length === 0) return null;
+
+  return (
+    layers.find((l) => l.name?.toLowerCase() === "main") ??
+    layers.find((l) => l.name?.toLowerCase() === "tile layer 1") ??
+    layers[0]
+  );
+}
